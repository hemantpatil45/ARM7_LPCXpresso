// Simple software delay loops using NOP instructions
void Delay1Sec(void) {
    volatile uint32_t i;
    for(i = 0; i < 12000000; i++) { __asm("NOP"); }
}

void Delay2Sec(void)
{
    volatile uint32_t i;
    for(i = 0; i < 1200000; i++) {
        __asm("NOP");
    }
}



