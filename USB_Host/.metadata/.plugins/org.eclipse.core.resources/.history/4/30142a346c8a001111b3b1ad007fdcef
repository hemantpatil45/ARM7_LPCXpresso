#include "LPC24xx.h"
#include "ff.h"
#include "usbhost.h"
#include "usbhost_ms.h"

extern void PLL_Init(void);
extern void system_Init(void);

FATFS fs;

/* Millisecond Delay Function */
void delayMs(DWORD timer_port, DWORD delayInMs) {
    for (volatile uint32_t i = 0; i < (delayInMs * 4000); i++);
}

/* UART0 Initialization for 115200 Baud */
void UART0_Init(uint32_t baudrate) {
    uint32_t Fdiv;
    PCONP |= (1 << 3);

    PCLKSEL0 &= ~(3 << 6);
    PCLKSEL0 |=  (1 << 6);

    PINSEL0 &= ~0x000000F0;
    PINSEL0 |=  0x00000050;
    U0LCR = 0x83;

    Fdiv = 3000000 / baudrate;

    U0DLM = (Fdiv >> 8) & 0xFF;
    U0DLL = Fdiv & 0xFF;
    U0FDR = 0x10;
    U0LCR = 0x03;
    U0FCR = 0x07;
}

/* Transmit a single character over UART0 */
void UART0_SendChar(char ch) {
    while (!(U0LSR & 0x20));
    U0THR = ch;
}

/* Print a string over UART0 */
void UART0_Print(const char *str) {
    while (*str) {
        UART0_SendChar(*str++);
    }
}

int main(void) {

    PLL_Init();
    system_Init();
    UART0_Init(115200);

    UART0_Print("\r\n[BOOT] LPC2478 USB Host Booting...\r\n");

    /* Initialize USB Host Hardware for Port 2 */
    USBHostInit();

    /* Wake up OHCI Controller */
    OHCIInit();

    /* Open Port 2 (Apply VBUS power) */
    OHCIPortOpen(2);

    UART0_Print("[USB] Scanning Port 2 for Flash Drive...\r\n");

    while (1) {
        if (MS_Init() == 0) {
            UART0_Print("[USB] Flash Drive Enumerated!\r\n");

            if (f_mount(&fs, "0:", 1) == FR_OK) {
                UART0_Print("[FAT] Drive successfully mounted!\r\n");
                while(1);
            } else {
                UART0_Print("[FAT] Failed to mount drive.\r\n");
            }
        }
    }
}
