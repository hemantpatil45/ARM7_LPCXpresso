#include "LPC24xx.h"
#include "ff.h"
#include "usbhost.h"
#include "usbhost_ms.h"

extern void PLL_Init(void);
extern void system_Init(void);
extern DWORD Host_EnumDev(void); /* Ensure Host_EnumDev prototype is visible */

FATFS fs;

/* Millisecond Delay Function scaled for a 48 MHz CCLK */
void delayMs(DWORD timer_port, DWORD delayInMs) {
    for (volatile uint32_t i = 0; i < (delayInMs * 12000); i++);
}

/* UART0 Initialization for 115200 Baud with 48 MHz PCLK */
void UART0_Init(uint32_t baudrate) {
    uint32_t pclk;
    uint32_t Fdiv;

    PCONP |= (1 << 3);

    PCLKSEL0 &= ~(3 << 6);
    PCLKSEL0 |=  (1 << 6);

    PINSEL0 &= ~0x000000F0;
    PINSEL0 |=  0x00000050;

    U0LCR = 0x83;

    pclk = 48000000;
    Fdiv = (pclk / 16) / baudrate;

    U0DLM = (Fdiv >> 8) & 0xFF;
    U0DLL = Fdiv & 0xFF;

    U0LCR = 0x03;
    U0FCR = 0x07;
}

void UART0_SendChar(char ch) {
    while (!(U0LSR & 0x20));
    U0THR = ch;
}

void UART0_Print(const char *str) {
    while (*str) {
        UART0_SendChar(*str++);
    }
}

int main(void) {
    DWORD rc;

    PLL_Init();
    system_Init();
    UART0_Init(115200);

    delayMs(1, 500);

    UART0_Print("\r\n[BOOT] LPC2478 USB Host Booting...\r\n");

    /* Initialize USB Host Hardware */
    /* Initialize USB Host Hardware */
        USBHostInit();

        /* Wake up OHCI Controller */
        OHCIInit();

        /* Open Port 1 (Native host port in UsbHostLite-Beta-1.0) */
        OHCIPortOpen(2);

        UART0_Print("[USB] Scanning Port 1 for Flash Drive...\r\n");

        while (1) {
                /* Enumerate connected USB device on Port 1 */
                if (Host_EnumDev() == OK) {
                    UART0_Print("[USB] Flash Drive Enumerated Successfully!\r\n");

                    /* Initialize Mass Storage Interface */
                    if (MS_Init() == 0) {
                        UART0_Print("[USB] Mass Storage Initialized!\r\n");

                        if (f_mount(&fs, "0:", 1) == FR_OK) {
                            UART0_Print("[FAT] Drive successfully mounted!\r\n");
                            while(1); /* Drive ready; proceed to file operations */
                        } else {
                            UART0_Print("[FAT] Failed to mount drive.\r\n");
                        }
                    } else {
                        UART0_Print("[USB] MS_Init failed.\r\n");
                    }
                }

                /* Pause before checking again if no drive is present */
                delayMs(1, 1000);
            }
}
