#include "LPC24xx.h"
#include "ff.h"
#include "usbhost.h"
#include "usbhost_ms.h"

extern void PLL_Init(void);
extern void system_Init(void);

FATFS fs;

/* Millisecond Delay Function scaled for a 48 MHz CCLK */
void delayMs(DWORD timer_port, DWORD delayInMs) {
    /* At 48 MHz, roughly 12,000 loop iterations equals 1 millisecond */
    for (volatile uint32_t i = 0; i < (delayInMs * 12000); i++);
}

/* UART0 Initialization for 115200 Baud with 48 MHz PCLK */
void UART0_Init(uint32_t baudrate) {
    uint32_t pclk;
    uint32_t Fdiv;

    /* Turn on power for UART0 */
    PCONP |= (1 << 3);

    /* Set peripheral clock divider to CCLK (PCLK = 48 MHz) */
    PCLKSEL0 &= ~(3 << 6);
    PCLKSEL0 |=  (1 << 6);  /* Binary 01: PCLK = CCLK = 48 MHz */

    /* Configure P0.2 as TXD0 and P0.3 as RXD0 */
    PINSEL0 &= ~0x000000F0;
    PINSEL0 |=  0x00000050;

    /* Enable DLAB to set baud rate divisors */
    U0LCR = 0x83;

    /*
     * For PCLK = 48 MHz and Baudrate = 115200:
     * Formula: Divisor = PCLK / (16 * Baudrate) = 48,000,000 / (16 * 115200) = 26.04
     */
    pclk = 48000000;
    Fdiv = (pclk / 16) / baudrate;

    U0DLM = (Fdiv >> 8) & 0xFF;
    U0DLL = Fdiv & 0xFF;

    /* Disable DLAB, set 8 data bits, 1 stop bit, no parity */
    U0LCR = 0x03;

    /* Enable and reset TX/RX FIFOs */
    U0FCR = 0x07;
}

/* Transmit a single character over UART0 */
void UART0_SendChar(char ch) {
    while (!(U0LSR & 0x20));
    U0THR = ch;
}

/* Print a string over UART0 */
void UART0_Print(const char *str) {
    while (*str) {
        UART0_SendChar(*str++);
    }
}

int main(void) {
    PLL_Init();
    system_Init();
    UART0_Init(115200);

    /* 500 ms startup delay for power rails and USB drive stabilization */
    delayMs(1, 500);

    UART0_Print("\r\n[BOOT] LPC2478 USB Host Booting...\r\n");

    /* Initialize USB Host Hardware for Port 2 */
    USBHostInit();

    /* Wake up OHCI Controller */
    OHCIInit();

    /* Open Port 2 (Apply VBUS power) */
    OHCIPortOpen(2);

    UART0_Print("[USB] Scanning Port 2 for Flash Drive...\r\n");

    while (1) {
        if (MS_Init() == 0) {
            UART0_Print("[USB] Flash Drive Enumerated!\r\n");

            if (f_mount(&fs, "0:", 1) == FR_OK) {
                UART0_Print("[FAT] Drive successfully mounted!\r\n");
                while(1);
            } else {
                UART0_Print("[FAT] Failed to mount drive.\r\n");
            }
        }
    }
}
