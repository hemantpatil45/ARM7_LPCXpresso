/*****************************************************************************
** Function name:        ISP1301_I2CRequest
**
** Descriptions:        Send a I2c Request to OTG chip ISP 1301.
**                        Normally, it's three bytes, in formatting the
**                        request, first with a I2C_START, the last with
**                        a I2C_STOP.
**
** parameters:            pointer to the request, data length
** Returned value:        None
** 
*****************************************************************************/
void ISP1301_I2CRequest( DWORD *ReqPtr, DWORD DataLen )
{
  DWORD i;

  for ( i = 0; i < DataLen; i++ )
  {
    OTG_I2C_TX = *(ReqPtr+i);
  }
  /* Wait for TDI bit to be set */ 
  while (!(OTG_I2C_STS & 0x1));

  /* Clear TDI bit */
  OTG_I2C_STS = 0x1;
  return;
}

/*****************************************************************************
** Function name:        USBHostHandler
**
** Descriptions:        USB host interrupt handler.
**
** parameters:            None
** Returned value:        None
** 
*****************************************************************************/
void __attribute__ ((interrupt("IRQ"))) USBHostHandler (void)
{
  OHCIIntDisable();

  if ( HC_INT_STAT & 0x01 )        // Scheduling overrun
  {
     HC_INT_STAT |= 0x01;
     intOverRunCnt++;
  }
  if ( HC_INT_STAT & 0x02 )        // Write back done
  {
    HC_INT_STAT |= 0x02;
    intWriteBackDoneCnt++;
  }
  if ( HC_INT_STAT & 0x04 )        // SOF packet
  {
    HC_INT_STAT |= 0x04;
    intSOFCnt++;
  }
  if ( HC_INT_STAT & 0x08 )        // Resume detected
  {
    HC_INT_STAT |= 0x08;
    intResumeDetectCnt++;
    OHCIInit();
  }
  if ( HC_INT_STAT & 0x10 )        // Unrecoverable error
  {
    HC_INT_STAT |= 0x10;
    intUnrecoverErrCnt++;
  }
  if ( HC_INT_STAT & 0x20 )        // Frame Number overflow
  {
    HC_INT_STAT |= 0x20;
    intFrameNumOverflowCnt++;
  }
  if ( HC_INT_STAT & 0x40 )        // Root hub status change
  {
    HC_INT_STAT |= 0x40;
    /* Update number of downstream port once RH status changes. */
    NumDownStreamPorts = HC_RH_DESCA & 0xFF;
    intRHStatusChangeCnt++;
  }
  if ( HC_INT_STAT & 0x80 )        // Ownership change
  {
    HC_INT_STAT |= 0x80;
    intOwnershipChangeCnt++;
  }
  OHCIIntEnable();
  VICVectAddr = 0;        /* Acknowledge Interrupt */
}

/*****************************************************************************
** Function name:        USBHostInit
**
** Descriptions:        USB host port initialization routine
**                      Set USB clock, GPIO pins for USB Port 2 (Host).
**
** parameters:          None
** Returned value:      TRUE
** 
*****************************************************************************/
DWORD USBHostInit(void)
{
  /* Turn on the USB subsystem power in PCONP */
  PCONP |= 0x80000000;

  /* Start all USB clocks */
  OTG_CLK_CTRL = 0x1F;
  while(OTG_CLK_STAT != 0x1F);

  /* --- CONFIGURE PINS FOR PORT 2 HOST --- */
  /* Clear the configuration bits for the target pins */
  PINSEL0 &= ~0x3F000000;
  PINSEL1 &= ~0xC0000000;
  PINSEL3 &= ~0xC0000000;

  /*
   * P0.12 -> M_USB_PPWR2   (Function 2 = 10)
   * P0.13 -> M_USB_UP_LED2 (Function 2 = 10)
   * P0.14 -> VBUS          (Function 1 = 01)
   * Binary mapping: 01 10 10 -> Hex: 0x1A
   */
  PINSEL0 |= 0x1A000000;

  /* P0.31 -> M_USB_D+2     (Function 1 = 01) */
  PINSEL1 |= 0x40000000;

  /* P1.31 -> M_USB_OVRCR2# (Function 1 = 01) */
  PINSEL3 |= 0x40000000;

  /* Disable pull-up/pull-down on the P1.31 overcurrent pin */
  PINMODE3 |= 0x80000000;

  /* Force the OTG controller to operate Port 2 strictly as a Host */
  OTG_STAT_CTRL = 0x02;

  return( TRUE );
}
/*****************************************************************************
** Function name:       Host_EnumDev
**
** Descriptions:        USB host device enumeration routine
**
** parameters:          None
** Returned value:      OK or ERROR
**
*****************************************************************************/
/* Helper function to print 32-bit hex values over UART0 */
static void UART0_PrintHex(uint32_t val) {
    char buf[11];
    buf[0] = '0';
    buf[1] = 'x';
    for (int i = 7; i >= 0; i--) {
        uint32_t nibble = (val >> (i * 4)) & 0xF;
        buf[9 - i] = (nibble < 10) ? ('0' + nibble) : ('A' + nibble - 10);
    }
    buf[10] = '\0';
    UART0_Print(buf);
}

/*****************************************************************************
** Function name:       Host_EnumDev
**
** Descriptions:        USB host device enumeration routine with raw debugging
**
** parameters:          None
** Returned value:      OK or ERROR
**
*****************************************************************************/
DWORD Host_EnumDev(void)
{
    DWORD port1_stat = HC_RH_PORT_STAT1;

    /* If Port Power is active (Bit 8) */
    if (port1_stat & (1 << 8))
    {
        /* Check if port is already enabled */
        if (port1_stat & (1 << 1))
        {
            return OK;
        }

        UART0_Print("[USB] Initiating compliant OHCI Port Reset...\r\n");

        /* Step 1: Set Port Reset (Bit 4) */
        HC_RH_PORT_STAT1 = (1 << 4);
        delayMs(1, 60); // Standard reset duration (min 50ms)

        /* Step 2: Clear Connect Change (Bit 16) and Reset Change (Bit 20) */
        HC_RH_PORT_STAT1 = (1 << 16) | (1 << 20);
        delayMs(1, 10);

        /* Step 3: Check if Port Enable Change (Bit 17) is set, and clear it */
        port1_stat = HC_RH_PORT_STAT1;
        if (port1_stat & (1 << 17))
        {
            UART0_Print("[USB] Clearing Port Enable Change flag...\r\n");
            HC_RH_PORT_STAT1 = (1 << 17);
        }

        /* Step 4: Re-read status to verify Port Enable Status (Bit 1) */
        delayMs(1, 10);
        port1_stat = HC_RH_PORT_STAT1;

        UART0_Print("[DEBUG] P1_STAT (Final Check): ");
        UART0_PrintHex(port1_stat);
        UART0_Print("\r\n");

        /* Check if Port Enable Status (Bit 1) is active */
        if (port1_stat & (1 << 1))
        {
            UART0_Print("[USB] Port successfully enabled!\r\n");
            return OK;
        }
        else
        {
            UART0_Print("[USB] Port reset completed, but Bit 1 (Enable) not set.\r\n");
        }
    }

    return ERROR;
}
