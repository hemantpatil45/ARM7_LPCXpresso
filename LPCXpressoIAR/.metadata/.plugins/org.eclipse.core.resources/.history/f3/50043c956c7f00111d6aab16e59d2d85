    FIO3SET =  0X70000000; //WRITE VALUE
    FIO4SET =  0X00000000; //WRITE VALUE

//************************************* IO PIN CLAR REGISTOR ***************************************
    FIO0CLR =  0X01200FF0; //WRITE VALUE
    FIO1CLR =  0X3FF0006C; //WRITE VALUE
    FIO2CLR =  0X0E0033FC; //WRITE VALUE
    FIO3CLR =  0X00000000; //WRITE VALUE
    FIO4CLR =  0X30000000; //WRITE VALUE

//************************************* IO PIN MASK REGISTOR ***************************************
// NO ANY MASKING IS USED
    FIO0MASK = 0;
    FIO1MASK = 0;
    FIO2MASK = 0;
    FIO3MASK = 0;
    FIO4MASK = 0;

}//SYSTEM INIT END

void Init_timer0()
{
  T0TCR = 0; // Disable timer 0.
  T0PR = 0x0; // Prescaler is set to no division.
  T0MR0 = 0x24000;  // Count up to this value. Generate interrupt for 10 ms / 0x9000 @ 3686400 Hz PCLK
  T0MCR = 0x03; // Reset and interrupt on MR0 (match register 0).
  T0CCR = 0; // Capture is disabled.
  T0EMR = 0; // No external match output.
}

void SDRAM_init_32BIT()
{
  PCONP_bit.PCEMC = 1;
  EMCCONTROL      = 1;         // enable EMC
  EMCDINAMICRDCFG = 1;
  EMCDYNAMICRASCAS0_bit.CAS = 3;
  EMCDYNAMICRASCAS0_bit.RAS = 3;
  EMCDYNAMICRP = P2C(SDRAM_TRP);
  EMCDYNAMICRAS = P2C(SDRAM_TRAS);
  EMCDYNAMICSREX = P2C(SDRAM_TXSR);
  EMCDYNAMICAPR = SDRAM_TAPR;
  EMCDYNAMICDAL = SDRAM_TDAL+P2C(SDRAM_TRP);
  EMCDYNAMICWR = SDRAM_TWR;
  EMCDYNAMICRC = P2C(SDRAM_TRC);
  EMCDYNAMICRFC = P2C(SDRAM_TRFC);
  EMCDYNAMICXSR = P2C(SDRAM_TXSR);
  EMCDYNAMICRRD = P2C(SDRAM_TRRD);
  EMCDYNAMICMRD = SDRAM_TMRD;
  EMCDYNAMICCFG0 = 0x0004680;        // 13 row, 9 - col, SDRAM
  // JEDEC General SDRAM Initialization Sequence
  // DELAY to allow power and clocks to stabilize ~100 us
  // NOP
  EMCDINAMICCTRL = 0x0183;

  for(volatile int i = 200*30; i;i--);
  // PALL
  EMCDINAMICCTRL_bit.I = 2;
  EMCDINAMICRFR = 1;
  for(volatile int i= 128; i; --i); // > 128 clk
  EMCDINAMICRFR = P2C(SDRAM_REFRESH) >> 4;
  // COMM
  EMCDINAMICCTRL_bit.I = 1;
  // Burst 4, Sequential, CAS-3
  volatile unsigned long Dummy = *(SDRAM_pointer+0x32);//(0x32 << 13)
  // NORM
  EMCDINAMICCTRL = 0x0000;///////////////////////
  EMCDYNAMICCFG0_bit.B = 1;/////////////////////
  for(volatile int i = 10000; i;i--);
}

void Uart_0_init_115200_WITH_PLL()
{
  //Set the FIFO enable bit in the FCR register. This bit must be set for
  //proper UART operation.
  U0FCR_bit.FCRFE = 0x01;

  //Set baudrate
  U0LCR_bit.DLAB = 0x01;
  U0DLL = BAUDRATEDIVISOR_115200_PLL & 0x00ff;
  U0DLM = (BAUDRATEDIVISOR_115200_PLL >> 8) & 0x00ff;
  U0LCR_bit.DLAB = 0x00;

  //Set mode
  U0LCR_bit.WLS = 0x3;   //8 bit word length
  U0LCR_bit.SBS = 0x0;   //1 stop bit
  U0LCR_bit.PE  = 0x0;   //No parity

  // UART0 interrupts
  U0IER_bit.RDAIE  = 0;  //Disable byte received interrupt
}
