/**************************************************************************
*   Fuction name  : Init_timer0()
*   input         : no
*   Description   :Initilize Timer0.
***************************************************************************/
//..........Init_timer0() FUNCTION
void Init_timer0()
{

  T0TCR = 0; // Disable timer 0.
  T0PR = 0x0; // Prescaler is set to no division.
  T0MR0 = 0x24000;  // Count up to this value. Generate interrupt for 10 ms / 0x9000 @ 3686400 Hz PCLK
  T0MCR = 0x03; // Reset and interrupt on MR0 (match register 0).
  T0CCR = 0; // Capture is disabled.
  T0EMR = 0; // No external match output.

}//TIMER0 END
