//IRQ exception handler. Calls the interrupt handlers.
_// Use GCC attributes to define the IRQ handler
void IRQ_Handler(void) __attribute__ ((interrupt ("IRQ")));
void IRQ_Handler(void)
{
    void (*interrupt_function)();
    unsigned int vector;

    vector = VICVectAddr;                     // Get interrupt vector[cite: 4].
    interrupt_function = (void(*)())vector;
    (*interrupt_function)();                  // Call vectored interrupt function.

    VICVectAddr = 0;                          // Clear interrupt in VIC[cite: 4].
}
// Paste these at the top of your file, before your main() function

// GCC equivalent for IAR's __disable_interrupt()
static inline void __disable_interrupt(void) {
    __asm volatile ("mrs r0, cpsr \n\t"
                    "orr r0, r0, #0x80 \n\t"  // Set bit 7 to disable IRQs
                    "msr cpsr_c, r0");
}

// GCC equivalent for IAR's __enable_interrupt()
static inline void __enable_interrupt(void) {
    __asm volatile ("mrs r0, cpsr \n\t"
                    "bic r0, r0, #0x80 \n\t"  // Clear bit 7 to enable IRQs
                    "msr cpsr_c, r0");
}

