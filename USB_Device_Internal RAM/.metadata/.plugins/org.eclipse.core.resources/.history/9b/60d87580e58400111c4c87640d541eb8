#include "LPC24xx.h"
#include "usbcore.h"
#include "usbhw.h"
#include "usbdesc.h"

// External UART print functions declared in main.c
extern void UART0_Print(const char *str);
extern void UART_PrintHex(uint32_t val);

USB_SETUP_PACKET SetupPacket;

void USB_EndPoint0(uint32_t event) {
    uint8_t *pData;
    uint32_t descriptor_size;

    if (event == 0) {
        uint32_t ep_stat = USB_ReadCmdData(CMD_SEL_EP);

        if (ep_stat & (1 << 2)) {
            // STP Bit set: Read incoming Setup Packet
            USB_ReadEP(0x00, (uint8_t *)&SetupPacket);

            UART0_Print("[EP0] Setup Packet Received -> RequestType: ");
            UART_PrintHex(SetupPacket.bmRequestType);
            UART0_Print(" Request: ");
            UART_PrintHex(SetupPacket.bRequest);
            UART0_Print(" Value: ");
            UART_PrintHex(SetupPacket.wValue);
            UART0_Print("\r\n");

            switch (SetupPacket.bRequest) {
                case USB_REQUEST_SET_ADDRESS:
                    UART0_Print("[EP0] Handling SET_ADDRESS...\r\n");
                    USB_SetAddress(SetupPacket.wValue);
                    USB_WriteEP(0x80, 0, 0);
                    break;

                case USB_REQUEST_GET_DESCRIPTOR:
                    UART0_Print("[EP0] Handling GET_DESCRIPTOR type: ");
                    UART_PrintHex(SetupPacket.wValue >> 8);
                    UART0_Print("\r\n");

                    switch (SetupPacket.wValue >> 8) {
                        case 0x01: // Device Descriptor
                            pData = (uint8_t *)USB_DeviceDescriptor;
                            descriptor_size = 18;
                            break;
                        case 0x02: // Configuration Descriptor
                            pData = (uint8_t *)USB_ConfigDescriptor;
                            descriptor_size = 32;
                            break;
                        default:
                            UART0_Print("[EP0] UNKNOWN DESCRIPTOR REQUEST! Stalling...\r\n");
                            USB_SetStallEP(0x80);
                            return;
                    }

                    if (descriptor_size > SetupPacket.wLength) {
                        descriptor_size = SetupPacket.wLength;
                    }

                    UART0_Print("[EP0] Writing descriptor bytes to Endpoint 0x80...\r\n");
                    USB_WriteEP(0x80, pData, descriptor_size);
                    break;

                case USB_REQUEST_SET_CONFIGURATION:
                    UART0_Print("[EP0] Handling SET_CONFIGURATION...\r\n");
                    USB_Configure(true);
                    USB_WriteEP(0x80, 0, 0);
                    break;

                default:
                    UART0_Print("[EP0] UNKNOWN REQUEST CODE! Stalling...\r\n");
                    USB_SetStallEP(0x80);
                    break;
            }
        } else {
            UART0_Print("[EP0] Status OUT packet acknowledged.\r\n");
            uint8_t dummy[64];
            USB_ReadEP(0x00, dummy);
        }
    }
}
