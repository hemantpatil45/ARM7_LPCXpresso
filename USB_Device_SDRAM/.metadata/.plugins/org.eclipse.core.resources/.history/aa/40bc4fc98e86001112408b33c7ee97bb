#include "LPC24xx.h"
#include <stdbool.h>

#define UART0_BAUD 115200

extern void PLL_Init(void);
extern void system_Init(void);

void Simple_Delay(void) {
    for (volatile uint32_t i = 0; i < 2000000; i++) {
        __asm("nop");
    }
}

void UART0_Init(uint32_t baudrate) {
    uint32_t Fdiv;

    // Power up UART0
    PCONP |= (1 << 3);

    // Set UART0 PCLK = CCLK
    PCLKSEL0 &= ~(3 << 6);
    PCLKSEL0 |=  (1 << 6);

    // P0.2 = TXD0, P0.3 = RXD0
    PINSEL0 &= ~0x000000F0;
    PINSEL0 |=  0x00000050;

    U0LCR = 0x83; // Enable DLAB

    // Assuming CCLK = 48MHz (48,000,000 / 16 = 3,000,000)
    // If your CCLK is 72MHz, change 3000000 to 4500000
    Fdiv = 3000000 / baudrate;

    U0DLM = (Fdiv >> 8) & 0xFF;
    U0DLL = Fdiv & 0xFF;
    U0FDR = 0x10;
    U0LCR = 0x03; // Disable DLAB, 8N1
    U0FCR = 0x07; // Enable and reset FIFOs
}

void UART0_SendChar(char ch) {
    while (!(U0LSR & 0x20));
    U0THR = ch;
}

void UART0_Print(const char *str) {
    while (*str) {
        UART0_SendChar(*str++);
    }
}

int main(void) {
    // 1. Initialize UART BEFORE any complex initialization
    UART0_Init(UART0_BAUD);

    // Test loop prior to PLL setup
    UART0_Print("\r\n--- UART ALIVE (Raw Reset Clock) ---\r\n");

    // 2. Test PLL Initialization
    PLL_Init();
    UART0_Print("[STEP 1] PLL Initialized.\r\n");

    // 3. Test System Initialization (EMC Pin Mux)
    system_Init();
    UART0_Print("[STEP 2] System & EMC Pins Initialized.\r\n");

    while (1) {
        UART0_Print("Heartbeat Ping...\r\n");
        Simple_Delay();
    }
}
