#include "LPC24xx.h"
#include "usbhw.h"
#include "usbcore.h"
#include "system_init.h"
#include "SDRAM.h"
#include <stdbool.h>

#define UART0_BAUD 115200

extern void PLL_Init(void);
extern void system_Init(void);
extern volatile bool usb_event_detected;

void Enable_Global_Interrupts(void) {
    __asm("mrs r0, cpsr");
    __asm("bic r0, r0, #0x80");
    __asm("msr cpsr_c, r0");
}

void UART0_Init(uint32_t baudrate) {
    uint32_t Fdiv;
    PCONP |= (1 << 3);

    PCLKSEL0 &= ~(3 << 6);
    PCLKSEL0 |=  (1 << 6);

    PINSEL0 &= ~0x000000F0;
    PINSEL0 |=  0x00000050;
    U0LCR = 0x83;

    Fdiv = 3000000 / baudrate;

    U0DLM = (Fdiv >> 8) & 0xFF;
    U0DLL = Fdiv & 0xFF;
    U0FDR = 0x10;
    U0LCR = 0x03;
    U0FCR = 0x07;
}

void UART0_SendChar(char ch) {
    while (!(U0LSR & 0x20));
    U0THR = ch;
}

void UART0_Print(const char *str) {
    while (*str) {
        UART0_SendChar(*str++);
    }
}

// Helper to print Hex values for debugging
void UART0_PrintHex(uint32_t val) {
    char hex[] = "0123456789ABCDEF";
    UART0_Print("0x");
    for (int i = 28; i >= 0; i -= 4) {
        UART0_SendChar(hex[(val >> i) & 0xF]);
    }
}

void delay_ms(uint32_t ms) {
    for (volatile uint32_t i = 0; i < (ms * 1000); i++);
}

int main(void) {
    // Uses your original 48MHz PLL initialization
    PLL_Init();
    system_Init();
    UART0_Init(UART0_BAUD);

    delay_ms(3000);
    UART0_Print("\r\n[BOOT] LPC2478 USB Booting...\r\n");
    delay_ms(100);

    UART0_Print("[MEM] Initializing SDRAM...\r\n");
    SDRAM_init_32BIT();

    // PHYSICAL SDRAM HARDWARE TEST
    UART0_Print("[TEST] Testing SDRAM Physical Bus...\r\n");
    volatile uint32_t *sdram_test = (volatile uint32_t *)0xA0000000;

    sdram_test[0] = 0xDEADBEEF;
    sdram_test[1] = 0x12345678;

    if (sdram_test[0] == 0xDEADBEEF && sdram_test[1] == 0x12345678) {
        UART0_Print("[TEST] SUCCESS! CPU can read/write to SDRAM.\r\n");
    } else {
        UART0_Print("[TEST] FATAL HARDWARE ERROR!\r\n");
        UART0_Print("Expected: 0xDEADBEEF, Got: ");
        UART0_PrintHex(sdram_test[0]);
        UART0_Print("\r\n");
        while(1);
    }

    // Write the rigid 32-bit boot sector signature
    Init_SDRAM_Disk();
    UART0_Print("[MEM] 32MB SDRAM Disk Formatted.\r\n");

    Enable_Global_Interrupts();
    UART0_Print("[CPU] Global Interrupts Enabled.\r\n");

    UART0_Print("[USB] Initializing USB Engine...\r\n");
    USB_Init();

    UART0_Print("[USB] Connecting to Bus (D+ pull-up)...\r\n");
    USB_Connect(true);

    while (1) {
        if (usb_event_detected) {
            usb_event_detected = false;
        }
    }
}
