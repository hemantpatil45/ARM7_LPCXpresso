#include "LPC24xx.h"
#include "usbhw.h"
#include "usbcore.h"
#include "system_init.h"
#include "upper_sdram.h"
#include <stdbool.h>

#define UART0_BAUD 115200

extern void PLL_Init(void);
extern void system_Init(void);
extern volatile bool usb_event_detected;

void UART0_Init(uint32_t baudrate) {
    uint32_t Fdiv;
    PCONP |= (1 << 3);
    PCLKSEL0 &= ~(3 << 6);
    PCLKSEL0 |=  (1 << 6);
    PINSEL0 &= ~0x000000F0;
    PINSEL0 |=  0x00000050;
    U0LCR = 0x83;
    Fdiv = 4500000 / baudrate;
    U0DLM = (Fdiv >> 8) & 0xFF;
    U0DLL = Fdiv & 0xFF;
    U0FDR = 0x10;
    U0LCR = 0x03;
    U0FCR = 0x07;
}

void UART0_Print(const char *str) {
    while (*str) {
        while (!(U0LSR & 0x20));
        U0THR = *str++;
    }
}

void delay_ms(uint32_t ms) {
    for (volatile uint32_t i = 0; i < (ms * 1000); i++);
}

int main(void) {
    PLL_Init();
    system_Init();
    UART0_Init(UART0_BAUD);

    delay_ms(3000);
    UART0_Print("\r\n========================================\r\n");
    UART0_Print("   LPC2478 USB VIRTUAL 16MB SDRAM DRIVE \r\n");
    UART0_Print("========================================\r\n");

    // 1. Initialize Upper SDRAM Bus
    UART0_Print("[MEM] Initializing Upper-16bit SDRAM...\r\n");
    UpperSDRAM_Init();

    // 2. Initialize USB Engine
    UART0_Print("[USB] Initializing USB Core...\r\n");
    USB_Init();

    UART0_Print("[USB] Connecting to Bus (D+ pull-up)...\r\n");
    USB_Connect(true);

    while (1) {
        if (usb_event_detected) {
            usb_event_detected = false;
        }
    }
}
