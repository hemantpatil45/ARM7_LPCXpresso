#include <LPC24xx.h>
#include "usbhw.h"

// --- internal helper to talk to the usb protocol engine ---
// you write a command code, and the silicon does the heavy lifting
void USB_WriteCmd(uint32_t cmd) {
    USBDevIntClr = 0x10; // clear the 'command code empty' interrupt flag
    USBCmdCode = cmd;    // shove the command into the engine

    // wait until the engine says it swallowed the command
    while ((USBDevIntSt & 0x10) == 0);
    USBDevIntClr = 0x10; // clear the flag again
}


// --- setup stuff ---

void USB_Init(void) {
    // 1. turn on the power to the usb block (PCUSB bit)
    PCONP |= (1 << 31);

    // 2. wire up the pins to the hardware engine (stealing them from your GPIO setup)

    // P0.29 (D+) and P0.30 (D-) -> set to alternate function 1 (binary 01)
    // clear the bits first, then set them
    PINSEL1 &= ~((3 << 26) | (3 << 28));
    PINSEL1 |=  ((1 << 26) | (1 << 28));

    // P1.30 (VBUS) -> set to alternate function 2 (binary 10)
    PINSEL3 &= ~(3 << 28);
    PINSEL3 |=  (2 << 28);

    // P2.9 (USB_CONNECT) -> set to alternate function 1 (binary 01)
    PINSEL4 &= ~(3 << 18);
    PINSEL4 |=  (1 << 18);

    // 3. crank up the usb clock (PLL1) to exactly 48MHz
    // *NOTE*: this math assumes your board has a 12MHz crystal!
    // 12MHz * 4 = 48MHz. If your crystal is different, we need to change M and P.

    PLL1CON = 1;         // enable PLL1
    PLL1FEED = 0xAA;     // standard weird NXP feed sequence to lock it in
    PLL1FEED = 0x55;

    // MSEL = 3 (which means M=4), PSEL = 1 (which means P=2)
    PLL1CFG = 0x23;
    PLL1FEED = 0xAA;
    PLL1FEED = 0x55;

    // wait for the hardware lock bit (bit 10) to go high
    while (!(PLL1STAT & (1 << 10)));

    // connect the pll to the usb engine
    PLL1CON = 3;
    PLL1FEED = 0xAA;
    PLL1FEED = 0x55;

    // 4. clear out any old garbage interrupts
    USBDevIntClr = 0x3FFF;
}

void USB_Connect(bool connect) {
    // we use the protocol engine to tell the silicon to pull P2.9 low.
    // command 0xFE is 'Set Device Status'.
    // data 1 = connect, 0 = disconnect.

    // 0x050000 tells the engine "I am writing data to you"
    USB_WriteCmd(0x00FE0500);

    if (connect) {
        // 0x010000 tells the engine "data bit 1" (connect!)
        USB_WriteCmd(0x00010100);
    } else {
        // 0x010000 tells the engine "data bit 0" (disconnect!)
        USB_WriteCmd(0x00000100);
    }
}


