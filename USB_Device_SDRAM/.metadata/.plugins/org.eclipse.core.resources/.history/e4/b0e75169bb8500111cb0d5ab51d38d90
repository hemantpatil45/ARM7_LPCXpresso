#include "LPC24xx.h"
#include <stdint.h>
#include "system_init.h"
#include "glcd.h"
#include "SDRAM.h"
#include "usbcore.h"
#include "usbhw.h"
#include "usbdesc.h"

#define SDRAM_BASE_ADDR 0xA0000000

void Format_SDRAM_As_FAT16(void) {
    volatile uint8_t *disk = (volatile uint8_t *)SDRAM_BASE_ADDR;

    // 1. Clear the first 64 KB of SDRAM (Reserved for Boot Sector, FATs, and Root Directory)
    for (uint32_t i = 0; i < 65536; i++) {
        disk[i] = 0x00;
    }

    // 2. Build a minimal FAT16 Boot Sector (BIOS Parameter Block - BPB) at Sector 0
    disk[0x00] = 0xEB; disk[0x01] = 0x3C; disk[0x02] = 0x90; // JMP instruction
    disk[0x03] = 'M';  disk[0x04] = 'S';  disk[0x05] = 'D';  disk[0x06] = 'O'; disk[0x07] = 'S'; disk[0x08] = '5'; disk[0x09] = '.', disk[0x0A] = '0'; // OEM Name

    // Bytes per sector: 512 (0x0200)
    disk[0x0B] = 0x00; disk[0x0C] = 0x02;
    // Sectors per cluster: 1
    disk[0x0D] = 0x01;
    // Reserved sector count: 1
    disk[0x0E] = 0x01; disk[0x0F] = 0x00;
    // Number of FAT tables: 2
    disk[0x10] = 0x02;
    // Maximum root directory entries: 64 (0x0040)
    disk[0x11] = 0x40; disk[0x12] = 0x00;
    // Total sectors (32 MB = 65,536 sectors -> 0x00010000)
    disk[0x13] = 0x00; disk[0x14] = 0x00;
    // Media descriptor (Fixed disk: 0xF8)
    disk[0x15] = 0xF8;
    // Sectors per FAT: 32
    disk[0x16] = 0x20; disk[0x17] = 0x00;
    // Sectors per track: 32
    disk[0x18] = 0x20; disk[0x19] = 0x00;
    // Number of heads: 2
    disk[0x1A] = 0x02; disk[0x1B] = 0x00;

    // Boot signature at the end of Sector 0 (Offset 510/511)
    disk[510] = 0x55;
    disk[511] = 0xAA;

    // 3. Initialize FAT Tables (Mark first two clusters as allocated/reserved)
    disk[512 + 0] = 0xF8; disk[512 + 1] = 0xFF;
    disk[512 + 2] = 0xFF; disk[512 + 3] = 0xFF;

    // FAT 2 starts after FAT 1 (Sector 1 + 32 = Sector 33 -> Byte offset 16896)
    disk[16896 + 0] = 0xF8; disk[16896 + 1] = 0xFF;
    disk[16896 + 2] = 0xFF; disk[16896 + 3] = 0xFF;
}

int main()
{
    // 1. Core System & Clock Initialization
    PLL_Init();
    system_Init();

    // 2. Display Setup
    GLCD_Init();
    GLCD_Clear();

    // 3. Initialize 32-Bit External SDRAM Controller (JEDEC Sequence)
    SDRAM_init_32BIT();

    // 4. Programmatically format SDRAM with FAT16 on boot
    Format_SDRAM_As_FAT16();

    // 5. Render Status on GLCD
    GLCD_RowWriteMargin(0, "WELCOME TO AKADEMIKA");
    GLCD_RowWriteMargin(1, "      PL-ARM7       ");
    GLCD_RowWriteMargin(3, "USB MASS STORAGE    ");
    GLCD_RowWriteMargin(4, "FAT16 SDRAM ACTIVE  ");
    GLCD_RowWriteMargin(6, "Plug into PC (Auto) ");

    // 6. Initialize USB Device Engine for Mass Storage
    USB_Init();
    USB_Connect(TRUE);

    // 7. Infinite Background Loop (USB interrupts handle block read/write transfers)
    while (1)
    {
    }
}
