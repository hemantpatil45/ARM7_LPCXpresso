#include "LPC24xx.h"
#include "usbhw.h"
#include "system_init.h"

#define UART0_BAUD 115200
#define CCLK_FREQ  48000000
#define PCLK_DIV   4
#define Fpclk      (CCLK_FREQ / PCLK_DIV)

extern void PLL_Init(void);
extern void system_Init(void);

void UART0_Init(uint32_t baudrate) {
    uint32_t Fdiv;

    PCONP |= (1 << 3);
    PCLKSEL0 &= ~(3 << 6);
    PINSEL0 &= ~0x000000F0;
    PINSEL0 |=  0x00000050;
    U0LCR = 0x83;

    Fdiv = (Fpclk / 16) / baudrate;
    U0DLM = (Fdiv >> 8) & 0xFF;
    U0DLL = Fdiv & 0xFF;
    U0FDR = 0x10;
    U0LCR = 0x03;
    U0FCR = 0x07;
}

void UART0_SendChar(char ch) {
    while (!(U0LSR & 0x20));
    U0THR = ch;
}

void UART0_Print(const char *str) {
    while (*str) {
        UART0_SendChar(*str++);
    }
}

void UART0_SendBuffer(const uint8_t *buf, uint32_t len) {
    for (uint32_t k = 0; k < len; k++) {
        while (!(U0LSR & 0x20));
        U0THR = buf[k];
    }
}

void delay_ms(uint32_t ms) {
    for (volatile uint32_t i = 0; i < (ms * 1000); i++);
}

void UART_PrintHex(uint32_t val) {
    char buf[11];
    buf[0] = '0';
    buf[1] = 'x';
    for (int i = 7; i >= 0; i--) {
        uint8_t nibble = (val >> (i * 4)) & 0x0F;
        buf[9 - i] = (nibble < 10) ? ('0' + nibble) : ('A' + nibble - 10);
    }
    buf[10] = '\0';
    UART0_Print(buf);
}

int main(void) {
    PLL_Init();
    system_Init();
    UART0_Init(UART0_BAUD);

    delay_ms(3000);

    UART0_Print("\r\n[BOOT] LPC2478 USB Booting...\r\n");
    delay_ms(100);

    UART0_Print("[USB] Initializing USB Engine...\r\n");

    VBUS_ON; // Activates hardware VBUS voltage sensing line

    USB_Init();

    UART0_Print("[USB] Connecting to Bus (D+ pull-up)...\r\n");
    USB_Connect(true);

    UART0_Print("[USB] Entering Main Loop.\r\n");

    while (1) {
        // Background loop execution
    }
}
