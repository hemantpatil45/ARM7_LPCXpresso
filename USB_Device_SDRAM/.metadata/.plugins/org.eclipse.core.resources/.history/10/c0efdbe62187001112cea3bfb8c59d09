#include "LPC24xx.h"
#include "SDRAM.h"
#include "system_init.h"
#include <stdint.h>

// Blocking loop tuned exactly for a 48MHz core clock
void timer_delay(unsigned int us) {
    for (volatile uint32_t i = 0; i < (us * 10); i++);
}

void SDRAM_init_32BIT(void)
{
    // 1. Enable EMC Power
    PCONP |= (1 << 11);

    // 2. Route Port 2 Control Pins (CAS, RAS, CLK, DYCS0, CKE, DQM0-3)
    PINSEL5 = 0x55010115;

    // 3. Route Port 3 Data Pins (D0 - D31)
    PINSEL6 = 0x55555555;
    PINSEL7 = 0x55555555;

    // 4. Route Port 4 Address Pins & Write Enable
    PINSEL8 = 0x55555555;
    PINSEL9 = (PINSEL9 & 0xFFF00000) | 0x00041555;

    // 5. EMC Timing Configuration (Hardcoded limits for 48 MHz)
    EMC_CTRL = 1;
    EMC_DYN_RD_CFG = 1;
    EMC_DYN_RASCAS0 = 0x00000303; // CAS=3, RAS=3

    EMC_DYN_RP   = 2;
    EMC_DYN_RAS  = 3;
    EMC_DYN_SREX = 4;
    EMC_DYN_APR  = 2;
    EMC_DYN_DAL  = 3;
    EMC_DYN_WR   = 2;
    EMC_DYN_RC   = 4;
    EMC_DYN_RFC  = 4;
    EMC_DYN_XSR  = 4;
    EMC_DYN_RRD  = 2;
    EMC_DYN_MRD  = 2;

    // 32-bit bus (Bit 14=1), AM=13 (0x0D << 7) for dual parallel 16MB chips
    EMC_DYN_CFG0 = 0x00004680;

    // 6. SDRAM Hardware Initialization Sequence
    timer_delay(100);
    EMC_DYN_CTRL = 0x0183;     // NOP + CKE = 1
    timer_delay(200);

    EMC_DYN_CTRL = 0x0103;     // PALL command
    timer_delay(100);

    EMC_DYN_RFSH = 2;          // Auto-refresh pulse
    timer_delay(10);
    EMC_DYN_RFSH = 23;         // Continuous refresh (48MHz formula)
    timer_delay(10);

    // 7. THE MODE COMMAND (Mandatory)
    EMC_DYN_CTRL = 0x0083;     // Enter MODE state

    // For AM=13, shift is 11. Send 0x33 (CAS 3, Burst 8) via dummy read.
    // In SDRAM.c -> SDRAM_init_32BIT()

    volatile unsigned int dummy = *((volatile unsigned int *)(0xA0000000 | (0x33 << 13)));
    (void)dummy;

    // 8. Normal Operation
    EMC_DYN_CTRL = 0x0000;
    EMC_DYN_CFG0 |= (1 << 19); // Enable EMC Write Buffers
    timer_delay(100);
}
