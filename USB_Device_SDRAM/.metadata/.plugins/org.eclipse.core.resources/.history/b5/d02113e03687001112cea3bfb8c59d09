#include "LPC24xx.h"
#include "usbcore.h"
#include "usbhw.h"
#include "usbdesc.h"
#include <stdbool.h>

extern void UART0_Print(const char *str);
extern void UART0_PrintHex(uint32_t val);
extern void UART0_SendChar(char ch);

void UART0_HexDump(uint8_t *data, uint32_t length) {
    for (uint32_t i = 0; i < length; i++) {
        uint8_t val = data[i];
        char hex[] = "0123456789ABCDEF";
        UART0_SendChar(hex[val >> 4]);
        UART0_SendChar(hex[val & 0x0F]);
        UART0_SendChar(' ');
        if ((i + 1) % 16 == 0) UART0_Print("\r\n");
    }
    UART0_Print("\r\n");
}

static bool writing_lba0 = false;
USB_SETUP_PACKET SetupPacket;
USB_CBW cbw;
USB_CSW csw;

// Force compiler to treat this as hardware memory
volatile uint8_t *SDRAM_Disk = (volatile uint8_t *)0xA0000000;
#define SDRAM_DISK_SIZE (32 * 1024 * 1024) // 32MB Drive

static const uint8_t SCSI_Sense_Data[] = {0x70, 0, 0x05, 0, 0, 0, 0, 10, 0, 0, 0, 0, 0x30, 0x01, 0, 0, 0, 0};
static const uint8_t SCSI_Mode_Data[]  = {0x03, 0x00, 0x00, 0x00};

volatile uint8_t *Bulk_Data_Ptr;
uint32_t Bulk_Data_Len;
bool Bulk_Sending_Data = false;

volatile uint8_t *Write_Data_Ptr;
uint32_t Write_Data_Len;
bool Bulk_Expecting_Write_Data = false;
uint32_t Expected_Transfer_Len = 0;
uint32_t Actual_Transferred_Len = 0;

void Init_SDRAM_Disk(void) {
    volatile uint32_t *sdram32 = (volatile uint32_t *)0xA0000000;

    // 1. Clear out the first 512KB of SDRAM
    for(int i = 0; i < (512 * 1024 / 4); i++) {
        sdram32[i] = 0;
    }

    // 2. Build the boot sector safely inside the CPU's internal SRAM
    // FIX: Force strict 32-bit alignment so the ARM7 processor does not rotate the bytes!
    uint32_t boot_sector32[512 / 4] = {0};
    uint8_t *boot_sector = (uint8_t *)boot_sector32;

    boot_sector[0] = 0xEB; boot_sector[1] = 0x3C; boot_sector[2] = 0x90;
    boot_sector[3] = 'L';  boot_sector[4] = 'P';  boot_sector[5] = 'C';
    boot_sector[6] = '2';  boot_sector[7] = '4';  boot_sector[8] = '7'; boot_sector[9] = '8'; boot_sector[10] = ' ';

    boot_sector[11] = 0x00; boot_sector[12] = 0x02; // Bytes per sector: 512 (0x0200)
    boot_sector[13] = 0x08;                         // Sectors per cluster: 8 (4KB clusters)
    boot_sector[14] = 0x01; boot_sector[15] = 0x00; // Reserved sector count: 1
    boot_sector[16] = 0x02;                         // Number of FAT tables: 2
    boot_sector[17] = 0x00; boot_sector[18] = 0x02; // Max root directory entries: 512 (0x0200)

    // Total sectors (16-bit FAT16 field) = 65,535
    boot_sector[19] = 0xFF;
    boot_sector[20] = 0xFF;

    boot_sector[21] = 0xF8;                         // Media descriptor: Fixed disk
    boot_sector[22] = 0x00; boot_sector[23] = 0x01; // Sectors per FAT (256)
    boot_sector[24] = 0x3F; boot_sector[25] = 0x00; // 63 sectors per track
    boot_sector[26] = 0xFF; boot_sector[27] = 0x00; // 255 heads

    // Extended Boot Record
    boot_sector[36] = 0x80;                         // BIOS drive number
    boot_sector[38] = 0x29;                         // Extended boot signature
    boot_sector[39] = 0x12; boot_sector[40] = 0x34; boot_sector[41] = 0x56; boot_sector[42] = 0x78; // Serial

    // Volume Label ("LPC DISK    ")
    boot_sector[43] = 'L'; boot_sector[44] = 'P'; boot_sector[45] = 'C'; boot_sector[46] = ' ';
    boot_sector[47] = 'D'; boot_sector[48] = 'I'; boot_sector[49] = 'S'; boot_sector[50] = 'K';
    boot_sector[51] = ' '; boot_sector[52] = ' '; boot_sector[53] = ' ';

    // File System Type ("FAT16   ")
    boot_sector[54] = 'F'; boot_sector[55] = 'A'; boot_sector[56] = 'T';
    boot_sector[57] = '1'; boot_sector[58] = '6'; boot_sector[59] = ' ';
    boot_sector[60] = ' '; boot_sector[61] = ' ';

    // Standard Boot Signature
    boot_sector[510] = 0x55;
    boot_sector[511] = 0xAA;

    // 3. Copy the completed boot sector to SDRAM using ONLY 32-bit words
    for(int i = 0; i < (512 / 4); i++) {
        sdram32[i] = boot_sector32[i]; // Safely copies aligned 32-bit words
    }
}

const uint8_t SCSI_Inquiry_Data[36] = {
    0x00, 0x80, 0x02, 0x02, 31, 0x00, 0x00, 0x00,
    'L', 'P', 'C', '2', '4', '7', '8', ' ',
    'D', 'e', 'v', 'i', 'c', 'e', ' ', ' ',
    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
    '1', '.', '0', '0'
};

// CAPACITY: 32 MB (65,536 sectors of 512 bytes mapped safely via 65,535 max LBA)
const uint8_t SCSI_Capacity_Data[8] = {
    0x00, 0x00, 0xFF, 0xFE, // Last LBA: 65534 (Total Sectors: 65535)
    0x00, 0x00, 0x02, 0x00  // Block Length: 512 bytes
};

void USB_EndPoint0(uint32_t event) {
    uint8_t *pData;
    uint32_t descriptor_size;

    if (event == 0) {
        USB_WriteCmd(CMD_SEL_EP + 0);
        uint32_t ep_stat = USB_ReadCmdData(CMD_SEL_EP + 0);

        if (ep_stat & (1 << 5)) {
            USB_ReadEP(0x00, (uint8_t *)&SetupPacket);

            switch (SetupPacket.bRequest) {
                case USB_REQUEST_SET_ADDRESS:
                    USB_SetAddress(SetupPacket.wValue);
                    USB_WriteEP(0x80, 0, 0);
                    break;
                case USB_REQUEST_GET_DESCRIPTOR:
                    switch (SetupPacket.wValue >> 8) {
                        case 0x01: pData = (uint8_t *)USB_DeviceDescriptor; descriptor_size = 18; break;
                        case 0x02: pData = (uint8_t *)USB_ConfigDescriptor; descriptor_size = 32; break;
                        default: USB_SetStallEP(0x80); return;
                    }
                    if (descriptor_size > SetupPacket.wLength) descriptor_size = SetupPacket.wLength;
                    USB_WriteEP(0x80, pData, descriptor_size);
                    break;
                case USB_REQUEST_SET_CONFIGURATION:
                    USB_Configure(true);
                    USB_ConfigEP(0x81, 64); USB_EnableEP(0x81);
                    USB_ConfigEP(0x02, 64); USB_EnableEP(0x02);
                    EP_INT_EN |= (1 << 3) | (1 << 4);
                    USB_WriteEP(0x80, 0, 0);
                    break;
                case 0xFE:
                    if (SetupPacket.bmRequestType == 0xA1) {
                        uint8_t max_lun = 0; USB_WriteEP(0x80, &max_lun, 1);
                    } else USB_SetStallEP(0x80);
                    break;
                default: USB_SetStallEP(0x80); break;
            }
        } else {
            uint8_t dummy[64]; USB_ReadEP(0x00, dummy);
        }
    }
}

void BOT_Send_Next_Chunk(void) {
    if (Bulk_Data_Len > 0) {
        uint32_t chunk = (Bulk_Data_Len > 64) ? 64 : Bulk_Data_Len;
        if (Bulk_Data_Ptr != 0) {
            USB_WriteEP(0x81, (uint8_t *)Bulk_Data_Ptr, chunk); // Cast to drop volatile warning
            Bulk_Data_Ptr += chunk;
        } else {
            uint8_t zeroes[64] = {0};
            USB_WriteEP(0x81, zeroes, chunk);
        }
        Bulk_Data_Len -= chunk;
        Actual_Transferred_Len += chunk;
    } else if (Bulk_Sending_Data) {
        Bulk_Sending_Data = false;
        csw.dCSWDataResidue = Expected_Transfer_Len - Actual_Transferred_Len;
        USB_WriteEP(0x81, (uint8_t *)&csw, 13);
    }
}

void Process_Bulk_OUT(void) {
    if (Bulk_Expecting_Write_Data) {
        uint8_t temp[64];
        uint32_t count;

        if (Write_Data_Ptr != 0) {
            count = USB_ReadEP(0x02, (uint8_t *)Write_Data_Ptr); // Cast to drop volatile warning
            Write_Data_Ptr += count;
        } else {
            count = USB_ReadEP(0x02, temp);
        }

        if (Write_Data_Len > count) Write_Data_Len -= count;
        else Write_Data_Len = 0;

        Actual_Transferred_Len += count;

        if (Write_Data_Len == 0) {
            Bulk_Expecting_Write_Data = false;
            csw.bCSWStatus = 0;
            csw.dCSWDataResidue = Expected_Transfer_Len - Actual_Transferred_Len;
            USB_WriteEP(0x81, (uint8_t *)&csw, 13);

            // --- ADD THIS DEBUG BLOCK ---
            if (writing_lba0) {
                UART0_Print("\r\n[USB] LBA 0 Write Complete! SDRAM now contains:\r\n");
                UART0_HexDump((uint8_t *)SDRAM_Disk, 48); // Dumps the first 48 bytes
                writing_lba0 = false;
            }
            // ----------------------------
        }
        return;
    }

    uint32_t count = USB_ReadEP(0x02, (uint8_t *)&cbw);
    if (count == 31 && cbw.dCBWSignature == 0x43425355) {
        csw.dCSWSignature = 0x53425355;
        csw.dCSWTag = cbw.dCBWTag;
        csw.bCSWStatus = 0;
        Expected_Transfer_Len = cbw.dCBWDataTransferLength;
        Actual_Transferred_Len = 0;

        switch (cbw.CBWCB[0]) {
            case 0x00:
                csw.dCSWDataResidue = 0;
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
            case 0x03:
                Bulk_Data_Ptr = (volatile uint8_t *)SCSI_Sense_Data;
                Bulk_Data_Len = sizeof(SCSI_Sense_Data);
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            case 0x12:
                Bulk_Data_Ptr = (volatile uint8_t *)SCSI_Inquiry_Data;
                Bulk_Data_Len = sizeof(SCSI_Inquiry_Data);
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            case 0x1A:
                Bulk_Data_Ptr = (volatile uint8_t *)SCSI_Mode_Data;
                Bulk_Data_Len = sizeof(SCSI_Mode_Data);
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            case 0x25:
                Bulk_Data_Ptr = (volatile uint8_t *)SCSI_Capacity_Data;
                Bulk_Data_Len = 8;
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;

            case 0x28: // READ
            {
                uint32_t lba = (cbw.CBWCB[2] << 24) | (cbw.CBWCB[3] << 16) | (cbw.CBWCB[4] << 8) | cbw.CBWCB[5];
                uint16_t blocks = (cbw.CBWCB[7] << 8) | cbw.CBWCB[8];
                uint32_t byte_offset = lba * 512;

                if (lba == 0) {
                    UART0_Print("\r\n[USB] Host READ LBA 0. Data being sent to Host:\r\n");
                    UART0_HexDump((uint8_t *)SDRAM_Disk, 48);
                }

                if ((byte_offset + (blocks * 512)) <= SDRAM_DISK_SIZE) Bulk_Data_Ptr = &SDRAM_Disk[byte_offset];
                else Bulk_Data_Ptr = 0;

                Bulk_Data_Len = blocks * 512;
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            }

            case 0x2A: // WRITE
            {
                uint32_t lba = (cbw.CBWCB[2] << 24) | (cbw.CBWCB[3] << 16) | (cbw.CBWCB[4] << 8) | cbw.CBWCB[5];
                uint16_t blocks = (cbw.CBWCB[7] << 8) | cbw.CBWCB[8];
                uint32_t byte_offset = lba * 512;

                if (lba == 0) {
                    UART0_Print("\r\n[USB] Host is WRITING Superblock (LBA 0)\r\n");
                    writing_lba0 = true;
                } else {
                    writing_lba0 = false;
                }

                if ((byte_offset + (blocks * 512)) <= SDRAM_DISK_SIZE) Write_Data_Ptr = &SDRAM_Disk[byte_offset];
                else Write_Data_Ptr = 0;

                Write_Data_Len = blocks * 512;
                Bulk_Expecting_Write_Data = true;
                break;
            }

            default:
                csw.dCSWDataResidue = Expected_Transfer_Len;
                csw.bCSWStatus = 0x01; // Command Failed Status
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
        }
    }
}
