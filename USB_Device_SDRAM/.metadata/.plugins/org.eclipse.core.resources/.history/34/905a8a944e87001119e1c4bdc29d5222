uint32_t USB_ReadEP(uint32_t EPNum, uint8_t *pData) {
    uint32_t phys_ep = EPAdrToPhys(EPNum);
    uint32_t logical_ep = EPNum & 0x0F;

    USB_WriteCmd(CMD_SEL_EP + phys_ep);
    USB_CTRL = (logical_ep << 2) | (1 << 0);

    uint32_t plength;
    do { plength = RX_PLENGTH; } while ((plength & 0x0800) == 0);
    uint32_t numBytes = plength & 0x3FF;

    // VIRTUAL DRIVE PACKING (Host -> Board)
    if (((uint32_t)pData & 3) == 0 && (uint32_t)pData >= 0xA0000000) {
        volatile uint32_t *sdram = (volatile uint32_t *)pData;
        for (uint32_t i = 0; i < (numBytes + 3) / 4; i++) {
            uint32_t word = RX_DATA;
            // Pack both 16-bit halves strictly into the UPPER 16-bits of the working SDRAM chip
            sdram[i*2]     = (word << 16);
            sdram[i*2 + 1] = (word & 0xFFFF0000);
        }
    } else if (((uint32_t)pData & 3) == 0) {
        uint32_t *pData32 = (uint32_t *)pData;
        for (uint32_t i = 0; i < (numBytes + 3) / 4; i++) pData32[i] = RX_DATA;
    } else {
        for (uint32_t i = 0; i < (numBytes + 3) / 4; i++) {
            uint32_t word = RX_DATA;
            for (int b = 0; b < 4; b++) {
                if ((i * 4) + b < numBytes) pData[(i * 4) + b] = (word >> (b * 8)) & 0xFF;
            }
        }
    }

    USB_CTRL = 0;
    USB_WriteCmd(CMD_SEL_EP + phys_ep);
    USB_WriteCmd(CMD_CLR_BUF);
    return numBytes;
}

uint32_t USB_WriteEP(uint32_t EPNum, uint8_t *pData, uint32_t cnt) {
    uint32_t phys_ep = EPAdrToPhys(EPNum);
    uint32_t logical_ep = EPNum & 0x0F;

    USB_CTRL = (logical_ep << 2) | (1 << 1);
    TX_PLENGTH = cnt;

    // VIRTUAL DRIVE UNPACKING (Board -> Host)
    if (((uint32_t)pData & 3) == 0 && (uint32_t)pData >= 0xA0000000) {
        volatile uint32_t *sdram = (volatile uint32_t *)pData;
        for (uint32_t i = 0; i < (cnt + 3) / 4; i++) {
            // Reconstruct the 32-bit word by reading ONLY the upper 16-bits of the working chip
            uint32_t lower = sdram[i*2] >> 16;
            uint32_t upper = sdram[i*2 + 1] >> 16;
            TX_DATA = (upper << 16) | lower;
        }
    } else if (((uint32_t)pData & 3) == 0) {
        uint32_t *pData32 = (uint32_t *)pData;
        for (uint32_t i = 0; i < (cnt + 3) / 4; i++) TX_DATA = pData32[i];
    } else {
        for (uint32_t i = 0; i < (cnt + 3) / 4; i++) {
            uint32_t word = 0;
            for (int b = 0; b < 4; b++) {
                if ((i * 4) + b < cnt) word |= ((uint32_t)pData[(i * 4) + b]) << (b * 8);
            }
            TX_DATA = word;
        }
    }

    USB_CTRL = 0;
    USB_WriteCmd(CMD_SEL_EP + phys_ep);
    USB_WriteCmd(CMD_VALID_BUF);
    return cnt;
}
