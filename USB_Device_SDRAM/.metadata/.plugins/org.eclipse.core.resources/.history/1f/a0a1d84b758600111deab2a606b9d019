#include "LPC24xx.h"
#include "SDRAM.h"
#include <stdint.h>

void timer_delay(unsigned int us) {
    for (volatile uint32_t i = 0; i < (us * 10); i++);
}

void SDRAM_init_32BIT(void)
{
    // 1. Enable EMC Power
    PCONP |= (1 << 11);

    // 2. Route all 32-bit Data, Control, and Address Pins
    PINSEL5 = 0x55010115;
    PINSEL6 = 0x55555555;
    PINSEL7 = 0x55555555;
    PINSEL8 = 0x55555555;
    PINSEL9 = (PINSEL9 & 0xFFF00000) | 0x00041555;

    // 3. Safe EMC Timing Configuration for 48 MHz
    EMC_CTRL = 1;
    EMC_DYN_RD_CFG = 1;
    EMC_DYN_RASCAS0 = 0x00000303;
    EMC_DYN_RP   = 2;
    EMC_DYN_RAS  = 3;
    EMC_DYN_SREX = 4;
    EMC_DYN_APR  = 2;
    EMC_DYN_DAL  = 3;
    EMC_DYN_WR   = 2;
    EMC_DYN_RC   = 4;
    EMC_DYN_RFC  = 4;
    EMC_DYN_XSR  = 4;
    EMC_DYN_RRD  = 2;
    EMC_DYN_MRD  = 2;

    // THE MAPPING FIX: 32-bit bus, AM=0x04 (32MB array: 12 Rows, 9 Cols)
    // This perfectly aligns the Bank Selects to your physical A13/A14 traces.
    EMC_DYN_CFG0 = 0x00004200;

    // 4. SDRAM Hardware Initialization Sequence
    timer_delay(100);
    EMC_DYN_CTRL = 0x0183;
    timer_delay(200);
    EMC_DYN_CTRL = 0x0103;
    timer_delay(100);
    EMC_DYN_RFSH = 2;
    timer_delay(10);
    EMC_DYN_RFSH = 23;
    timer_delay(10);

    // 5. THE BURST FIX: 0x30 forces CAS 3, Burst Length 1 (Mandatory for LPC2478)
    // Shift is 13 for AM=0x04 mapping on a 32-bit bus.
    EMC_DYN_CTRL = 0x0083;
    volatile uint32_t dummy = *((volatile uint32_t *)(0xA0000000 | (0x30 << 13)));
    (void)dummy;

    // 6. Normal Operation (Write Buffer intentionally left OFF for diagnostic purity)
    // 0x0003 keeps the Clock Enable (CKE) running continuously.
    EMC_DYN_CTRL = 0x0003;
    timer_delay(100);
}
