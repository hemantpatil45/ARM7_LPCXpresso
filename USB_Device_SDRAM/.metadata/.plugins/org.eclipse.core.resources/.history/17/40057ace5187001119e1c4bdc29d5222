#include "LPC24xx.h"
#include "usbcore.h"
#include "usbhw.h"
#include "usbdesc.h"
#include <stdbool.h>

extern void UART0_Print(const char *str);
extern void UART0_PrintHex(uint32_t val);

USB_SETUP_PACKET SetupPacket;
USB_CBW cbw;
USB_CSW csw;

uint8_t *SDRAM_Disk = (uint8_t *)0xA0000000;
#define SDRAM_DISK_SIZE (32 * 1024 * 1024)

uint8_t *Bulk_Data_Ptr;
uint32_t Bulk_Data_Len;
bool Bulk_Sending_Data = false;

uint8_t *Write_Data_Ptr;
uint32_t Write_Data_Len;
bool Bulk_Expecting_Write_Data = false;
uint32_t Expected_Transfer_Len = 0;
uint32_t Actual_Transferred_Len = 0;

void Init_SDRAM_Disk(void) {
    uint32_t *sdram32 = (uint32_t *)0xA0000000;

    // Clear the first sector (512 bytes = 128 words)
    for(int i = 0; i < 128; i++) {
        sdram32[i] = 0;
    }

    // Word 0 (Bytes 0-3): JMP instruction (0xEB, 0x3C, 0x90) + 'L' (0x4C)
    // Little-endian layout: [0]=0xEB, [1]=0x3C, [2]=0x90, [3]=0x4C
    sdram32[0] = 0x4C903CEB;

    // Word 1 (Bytes 4-7): OEM Name 'P', 'C', '2', '4'
    sdram32[1] = 0x34324350;

    // Word 2 (Bytes 8-11): OEM Name '7', '8', ' ', ' '
    sdram32[2] = 0x20203837;

    // Word 3 (Bytes 12-15): Bytes per sector (512 = 0x0200), Sectors per cluster, Reserved sectors
    sdram32[3] = 0x00010200;

    // Word 4 (Bytes 16-19): Number of FATs (2), Root entries, Total sectors (16-bit field)
    sdram32[4] = 0xFFFF0200; // 0xFFFF for FAT16 extension

    // Word 5 (Bytes 20-23): Media descriptor (0xF8), Sectors per FAT
    sdram32[5] = 0x010000F8;

    // Word 6 (Bytes 24-27): Sectors per track (0x3F), Number of heads (0xFF)
    sdram32[6] = 0x0000003F; // Note: adjusted to match your previous 0x3F, 0xFF layout

    // Word 9 (Bytes 36-39): Drive number (0x80), Reserved, Boot signature (0x29)
    sdram32[9] = 0x29008000;

    // Word 10-12 (Bytes 40-51): Volume Serial Number & Volume Label ('LPC DISK')
    sdram32[10] = 0x56781234; // Serial
    sdram32[11] = 0x43534944; // "DISC"
    sdram32[12] = 0x20202050; // "P   "

    // Word 13 (Bytes 52-55): File system type ('FAT1')
    sdram32[13] = 0x31544146; // "FAT1"

    // Word 14 (Bytes 56-59): File system type ('6   ')
    sdram32[14] = 0x20202036; // "6   "

    // Set the boot sector signature (0xAA55) at the very last word of the 512-byte sector (Offset 510)
    // 510 / 4 = index 127. The signature goes into the lower 16 bits of word 127.
    sdram32[127] = 0x0000AA55;
}

const uint8_t SCSI_Inquiry_Data[36] = {
    0x00, 0x80, 0x02, 0x02, 31, 0x00, 0x00, 0x00,
    'L', 'P', 'C', '2', '4', '7', '8', ' ',
    'D', 'e', 'v', 'i', 'c', 'e', ' ', ' ',
    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
    '1', '.', '0', '0'
};

const uint8_t SCSI_Capacity_Data[8] = {
    0x00, 0x00, 0xFF, 0xFF,
    0x00, 0x00, 0x02, 0x00
};

void USB_EndPoint0(uint32_t event) {
    uint8_t *pData;
    uint32_t descriptor_size;

    if (event == 0) {
        USB_WriteCmd(CMD_SEL_EP + 0);
        uint32_t ep_stat = USB_ReadCmdData(CMD_SEL_EP + 0);

        if (ep_stat & (1 << 5)) {
            USB_ReadEP(0x00, (uint8_t *)&SetupPacket);

            switch (SetupPacket.bRequest) {
                case USB_REQUEST_SET_ADDRESS:
                    USB_SetAddress(SetupPacket.wValue);
                    USB_WriteEP(0x80, 0, 0);
                    break;
                case USB_REQUEST_GET_DESCRIPTOR:
                    switch (SetupPacket.wValue >> 8) {
                        case 0x01: pData = (uint8_t *)USB_DeviceDescriptor; descriptor_size = 18; break;
                        case 0x02: pData = (uint8_t *)USB_ConfigDescriptor; descriptor_size = 32; break;
                        default: USB_SetStallEP(0x80); return;
                    }
                    if (descriptor_size > SetupPacket.wLength) descriptor_size = SetupPacket.wLength;
                    USB_WriteEP(0x80, pData, descriptor_size);
                    break;
                case USB_REQUEST_SET_CONFIGURATION:
                    USB_Configure(true);
                    USB_ConfigEP(0x81, 64); USB_ConfigEP(0x02, 64);
                    EP_INT_EN |= (1 << 3) | (1 << 4);
                    USB_WriteEP(0x80, 0, 0);
                    break;
                case 0xFE:
                    if (SetupPacket.bmRequestType == 0xA1) {
                        uint8_t max_lun = 0; USB_WriteEP(0x80, &max_lun, 1);
                    } else USB_SetStallEP(0x80);
                    break;
                default: USB_SetStallEP(0x80); break;
            }
        } else {
            uint8_t dummy[64]; USB_ReadEP(0x00, dummy);
        }
    }
}

void BOT_Send_Next_Chunk(void) {
    if (Bulk_Data_Len > 0) {
        uint32_t chunk = (Bulk_Data_Len > 64) ? 64 : Bulk_Data_Len;
        if (Bulk_Data_Ptr != 0) {
            USB_WriteEP(0x81, Bulk_Data_Ptr, chunk);
            Bulk_Data_Ptr += chunk;
        } else {
            uint8_t zeroes[64] = {0};
            USB_WriteEP(0x81, zeroes, chunk);
        }
        Bulk_Data_Len -= chunk;
        Actual_Transferred_Len += chunk;
    } else if (Bulk_Sending_Data) {
        Bulk_Sending_Data = false;
        csw.dCSWDataResidue = Expected_Transfer_Len - Actual_Transferred_Len;
        USB_WriteEP(0x81, (uint8_t *)&csw, 13);
    }
}

void Process_Bulk_OUT(void) {
    if (Bulk_Expecting_Write_Data) {
        uint8_t temp[64];
        uint32_t count;

        if (Write_Data_Ptr != 0) {
            count = USB_ReadEP(0x02, Write_Data_Ptr);
            UART0_Print("[USB] Write Chunk Received!\r\n");
            Write_Data_Ptr += count;
        } else {
            count = USB_ReadEP(0x02, temp);
        }

        if (Write_Data_Len > count) Write_Data_Len -= count;
        else Write_Data_Len = 0;

        Actual_Transferred_Len += count;

        if (Write_Data_Len == 0) {
            Bulk_Expecting_Write_Data = false;
            csw.bCSWStatus = 0;
            csw.dCSWDataResidue = Expected_Transfer_Len - Actual_Transferred_Len;
            USB_WriteEP(0x81, (uint8_t *)&csw, 13);
        }
        return;
    }

    uint32_t count = USB_ReadEP(0x02, (uint8_t *)&cbw);
    if (count == 31 && cbw.dCBWSignature == 0x43425355) {
        csw.dCSWSignature = 0x53425355;
        csw.dCSWTag = cbw.dCBWTag;
        csw.bCSWStatus = 0;
        Expected_Transfer_Len = cbw.dCBWDataTransferLength;
        Actual_Transferred_Len = 0;

        switch (cbw.CBWCB[0]) {
            case 0x00:
                csw.dCSWDataResidue = 0;
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
            case 0x03:
                Bulk_Data_Ptr = (uint8_t[]){0x70, 0, 0x05, 0, 0, 0, 0, 10, 0, 0, 0, 0, 0x30, 0x01, 0, 0, 0, 0};
                Bulk_Data_Len = 18; Bulk_Sending_Data = true; BOT_Send_Next_Chunk(); break;
            case 0x12:
                Bulk_Data_Ptr = (uint8_t *)SCSI_Inquiry_Data; Bulk_Data_Len = sizeof(SCSI_Inquiry_Data);
                Bulk_Sending_Data = true; BOT_Send_Next_Chunk(); break;
            case 0x1A:
                Bulk_Data_Ptr = (uint8_t[]){0x03, 0x00, 0x00, 0x00}; Bulk_Data_Len = 4;
                Bulk_Sending_Data = true; BOT_Send_Next_Chunk(); break;
            case 0x25:
                Bulk_Data_Ptr = (uint8_t *)SCSI_Capacity_Data; Bulk_Data_Len = 8;
                Bulk_Sending_Data = true; BOT_Send_Next_Chunk(); break;

            case 0x28:
            {
                uint32_t lba = (cbw.CBWCB[2] << 24) | (cbw.CBWCB[3] << 16) | (cbw.CBWCB[4] << 8) | cbw.CBWCB[5];
                uint16_t blocks = (cbw.CBWCB[7] << 8) | cbw.CBWCB[8];
                uint32_t byte_offset = lba * 512;

                if (lba == 0) {
                    UART0_Print("\r\n[USB] Host READ Superblock (LBA 0)\r\n");
                    UART0_Print("[USB] First 4 bytes: ");
                    uint32_t *first_word = (uint32_t *)&SDRAM_Disk[0];
                    UART0_PrintHex(*first_word);
                    UART0_Print("\r\n");
                }

                if ((byte_offset + (blocks * 512)) <= SDRAM_DISK_SIZE) Bulk_Data_Ptr = &SDRAM_Disk[byte_offset];
                else Bulk_Data_Ptr = 0;

                Bulk_Data_Len = blocks * 512;
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            }

            case 0x2A:
            {
                uint32_t lba = (cbw.CBWCB[2] << 24) | (cbw.CBWCB[3] << 16) | (cbw.CBWCB[4] << 8) | cbw.CBWCB[5];
                uint16_t blocks = (cbw.CBWCB[7] << 8) | cbw.CBWCB[8];
                uint32_t byte_offset = lba * 512;

                if (lba == 0) {
                    UART0_Print("\r\n[USB] Host is WRITING Superblock (LBA 0)\r\n");
                }

                if ((byte_offset + (blocks * 512)) <= SDRAM_DISK_SIZE) Write_Data_Ptr = &SDRAM_Disk[byte_offset];
                else Write_Data_Ptr = 0;

                Write_Data_Len = blocks * 512;
                Bulk_Expecting_Write_Data = true;
                break;
            }

            default:
                csw.dCSWDataResidue = Expected_Transfer_Len;
                csw.bCSWStatus = 0x01;
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
        }
    }
}
