uint32_t USB_ReadEP(uint32_t EPNum, uint8_t *pData) {
    uint32_t phys_ep = EPAdrToPhys(EPNum);
    uint32_t logical_ep = EPNum & 0x0F;

    USB_WriteCmd(CMD_SEL_EP + phys_ep);
    USB_CTRL = (logical_ep << 2) | (1 << 0);

    uint32_t plength;
    do {
        plength = RX_PLENGTH;
    } while ((plength & 0x0800) == 0);

    uint32_t numBytes = plength & 0x3FF;

    if ((uint32_t)pData >= 0xA0000000) {
        // STRICT 16-BIT SDRAM TRANSFER
        uint16_t *pData16 = (uint16_t *)pData;
        for (uint32_t i = 0; i < numBytes / 4; i++) {
            uint32_t word = RX_DATA;
            pData16[i * 2] = word & 0xFFFF;
            pData16[(i * 2) + 1] = (word >> 16) & 0xFFFF;
        }
    } else {
        // Descriptor 8-bit fallback
        for (uint32_t i = 0; i < (numBytes + 3) / 4; i++) {
            uint32_t word = RX_DATA;
            for (int b = 0; b < 4; b++) {
                uint32_t index = (i * 4) + b;
                if (index < numBytes) {
                    pData[index] = (word >> (b * 8)) & 0xFF;
                }
            }
        }
    }

    USB_CTRL = 0;
    USB_WriteCmd(CMD_SEL_EP + phys_ep);
    USB_WriteCmd(CMD_CLR_BUF);

    return numBytes;
}

uint32_t USB_WriteEP(uint32_t EPNum, uint8_t *pData, uint32_t cnt) {
    uint32_t phys_ep = EPAdrToPhys(EPNum);
    uint32_t logical_ep = EPNum & 0x0F;

    USB_CTRL = (logical_ep << 2) | (1 << 1);
    TX_PLENGTH = cnt;

    if ((uint32_t)pData >= 0xA0000000) {
        // STRICT 16-BIT SDRAM TRANSFER
        uint16_t *pData16 = (uint16_t *)pData;
        for (uint32_t i = 0; i < cnt / 4; i++) {
            uint32_t word = pData16[i * 2];
            word |= ((uint32_t)pData16[(i * 2) + 1]) << 16;
            TX_DATA = word;
        }
    } else {
        // Descriptor 8-bit fallback
        for (uint32_t i = 0; i < (cnt + 3) / 4; i++) {
            uint32_t word = 0;
            for (int b = 0; b < 4; b++) {
                uint32_t index = (i * 4) + b;
                if (index < cnt) {
                    word |= ((uint32_t)pData[index]) << (b * 8);
                }
            }
            TX_DATA = word;
        }
    }

    USB_CTRL = 0;
    USB_WriteCmd(CMD_SEL_EP + phys_ep);
    USB_WriteCmd(CMD_VALID_BUF);

    return cnt;
}
