#include "LPC24xx.h"
#include "usbhw.h"
#include "system_init.h"
#include <stdbool.h>

#define UART0_BAUD 115200

// External system inits
extern void system_Init(void);
extern volatile bool usb_event_detected;
extern volatile uint32_t last_disr;
extern volatile uint32_t last_episr;

void Enable_Global_Interrupts(void) {
    __asm("mrs r0, cpsr");
    __asm("bic r0, r0, #0x80");
    __asm("msr cpsr_c, r0");
}

// ---------------------------------------------------------
// NEW: Mathematically perfect PLL lock for USB 48MHz
// Assuming a standard 12 MHz external crystal
// ---------------------------------------------------------
void Force_Perfect_USB_Clock(void) {
    // 1. Disconnect and Disable the PLL
    PLLCON = 0x00;
    PLLFEED = 0xAA;
    PLLFEED = 0x55;

    // 2. Select Main Oscillator as source (12MHz)
    CLKSRCSEL = 0x01;

    // 3. Set PLL for exactly 288MHz Fcco
    // M=12 (MSEL=11 or 0x0B), N=1 (NSEL=0)
    PLLCFG = 0x0000000B;
    PLLFEED = 0xAA;
    PLLFEED = 0x55;

    // 4. Enable the PLL
    PLLCON = 0x01;
    PLLFEED = 0xAA;
    PLLFEED = 0x55;

    // 5. Wait for the hardware lock (Bit 26)
    while (!(PLLSTAT & (1 << 26)));

    // 6. Set CPU and USB dividers
    CCLKCFG = 5;      // CPU Clock = 288 / (5+1) = 48 MHz
    USBCLKCFG = 6;    // USB Clock = 288 / 6 = 48 MHz exactly

    // 7. Connect the PLL to the system
    PLLCON = 0x03;
    PLLFEED = 0xAA;
    PLLFEED = 0x55;
}

void UART0_Init(uint32_t baudrate) {
    uint32_t Fdiv;
    PCONP |= (1 << 3);
    PCLKSEL0 &= ~(3 << 6);
    PINSEL0 &= ~0x000000F0;
    PINSEL0 |=  0x00000050;
    U0LCR = 0x83;

    // CPU is now exactly 48MHz, PCLK is 48/4 = 12MHz
    Fdiv = (12000000 / 16) / baudrate;

    U0DLM = (Fdiv >> 8) & 0xFF;
    U0DLL = Fdiv & 0xFF;
    U0FDR = 0x10;
    U0LCR = 0x03;
    U0FCR = 0x07;
}

void UART0_SendChar(char ch) {
    while (!(U0LSR & 0x20));
    U0THR = ch;
}

void UART0_Print(const char *str) {
    while (*str) {
        UART0_SendChar(*str++);
    }
}

void delay_ms(uint32_t ms) {
    for (volatile uint32_t i = 0; i < (ms * 1000); i++);
}

void UART_PrintHex(uint32_t val) {
    char buf[11];
    buf[0] = '0';
    buf[1] = 'x';
    for (int i = 7; i >= 0; i--) {
        uint8_t nibble = (val >> (i * 4)) & 0x0F;
        buf[9 - i] = (nibble < 10) ? ('0' + nibble) : ('A' + nibble - 10);
    }
    buf[10] = '\0';
    UART0_Print(buf);
}

int main(void) {
    // Override the buggy PLL_Init with the perfect USB clock calculation
    Force_Perfect_USB_Clock();

    // Initialize standard GPIOs
    system_Init();

    // Initialize UART safely with the known 48MHz clock
    UART0_Init(UART0_BAUD);

    delay_ms(3000);
    UART0_Print("\r\n[BOOT] LPC2478 USB Booting with Perfect 48MHz Clock...\r\n");
    delay_ms(100);

    Enable_Global_Interrupts();
    UART0_Print("[CPU] Global Interrupts Enabled.\r\n");

    UART0_Print("[USB] Initializing USB Engine...\r\n");
    VBUS_ON;
    USB_Init();

    UART0_Print("[USB] Connecting to Bus (D+ pull-up)...\r\n");
    USB_Connect(true);

    UART0_Print("[USB] Entering Main Loop.\r\n");

    while (1) {
        if (usb_event_detected) {
            usb_event_detected = false;

            UART0_Print("[MainLoop] ISR Triggered! DEV_INT_STAT: ");
            UART_PrintHex(last_disr);
            UART0_Print(" | EP_INT_STAT: ");
            UART_PrintHex(last_episr);
            UART0_Print("\r\n");
        }
    }
}
