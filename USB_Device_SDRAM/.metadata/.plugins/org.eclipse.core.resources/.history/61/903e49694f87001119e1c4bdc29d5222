#include "LPC24xx.h"
#include "usbcore.h"
#include "usbhw.h"
#include "usbdesc.h"
#include <stdbool.h>

extern void UART0_Print(const char *str);
extern void UART0_PrintHex(uint32_t val);
extern void UART0_SendChar(char ch);

void UART0_HexDump(uint8_t *data, uint32_t length) {
    for (uint32_t i = 0; i < length; i++) {
        uint8_t val = data[i];
        char hex[] = "0123456789ABCDEF";
        UART0_SendChar(hex[val >> 4]);
        UART0_SendChar(hex[val & 0x0F]);
        UART0_SendChar(' ');
        if ((i + 1) % 16 == 0) UART0_Print("\r\n");
    }
    UART0_Print("\r\n");
}

static bool writing_lba0 = false;
USB_SETUP_PACKET SetupPacket;
USB_CBW cbw;
USB_CSW csw;

// Force compiler to treat this as hardware memory
volatile uint8_t *SDRAM_Disk = (volatile uint8_t *)0xA0000000;
#define SDRAM_DISK_SIZE (32 * 1024 * 1024) // 32MB Physical Drive Size

static const uint8_t SCSI_Sense_Data[] = {0x70, 0, 0x05, 0, 0, 0, 0, 10, 0, 0, 0, 0, 0x30, 0x01, 0, 0, 0, 0};
static const uint8_t SCSI_Mode_Data[]  = {0x03, 0x00, 0x00, 0x00};

volatile uint8_t *Bulk_Data_Ptr;
uint32_t Bulk_Data_Len;
bool Bulk_Sending_Data = false;

volatile uint8_t *Write_Data_Ptr;
uint32_t Write_Data_Len;
bool Bulk_Expecting_Write_Data = false;
uint32_t Expected_Transfer_Len = 0;
uint32_t Actual_Transferred_Len = 0;

void Init_SDRAM_Disk(void) {
    volatile uint32_t *sdram32 = (volatile uint32_t *)0xA0000000;
    // Clear 1MB of physical memory (covers 512KB of logical FAT tables)
    for(int i = 0; i < (1024 * 1024 / 4); i++) {
        sdram32[i] = 0;
    }
}

const uint8_t SCSI_Inquiry_Data[36] = {
    0x00, 0x80, 0x02, 0x02, 31, 0x00, 0x00, 0x00,
    'L', 'P', 'C', '2', '4', '7', '8', ' ',
    'D', 'e', 'v', 'i', 'c', 'e', ' ', ' ',
    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
    '1', '.', '0', '0'
};

// CAPACITY: 16 MB (32,768 sectors mapped)
const uint8_t SCSI_Capacity_Data[8] = {
    0x00, 0x00, 0x7F, 0xFF, // Last LBA: 32767
    0x00, 0x00, 0x02, 0x00  // Block Length: 512 bytes
};

void USB_EndPoint0(uint32_t event) {
    uint8_t *pData;
    uint32_t descriptor_size;

    if (event == 0) {
        USB_WriteCmd(CMD_SEL_EP + 0);
        uint32_t ep_stat = USB_ReadCmdData(CMD_SEL_EP + 0);

        if (ep_stat & (1 << 5)) {
            USB_ReadEP(0x00, (uint8_t *)&SetupPacket);

            switch (SetupPacket.bRequest) {
                case USB_REQUEST_SET_ADDRESS:
                    USB_SetAddress(SetupPacket.wValue);
                    USB_WriteEP(0x80, 0, 0);
                    break;
                case USB_REQUEST_GET_DESCRIPTOR:
                    switch (SetupPacket.wValue >> 8) {
                        case 0x01: pData = (uint8_t *)USB_DeviceDescriptor; descriptor_size = 18; break;
                        case 0x02: pData = (uint8_t *)USB_ConfigDescriptor; descriptor_size = 32; break;
                        default: USB_SetStallEP(0x80); return;
                    }
                    if (descriptor_size > SetupPacket.wLength) descriptor_size = SetupPacket.wLength;
                    USB_WriteEP(0x80, pData, descriptor_size);
                    break;
                case USB_REQUEST_SET_CONFIGURATION:
                    USB_Configure(true);
                    USB_ConfigEP(0x81, 64); USB_EnableEP(0x81);
                    USB_ConfigEP(0x02, 64); USB_EnableEP(0x02);
                    EP_INT_EN |= (1 << 3) | (1 << 4);
                    USB_WriteEP(0x80, 0, 0);
                    break;
                case 0xFE:
                    if (SetupPacket.bmRequestType == 0xA1) {
                        uint8_t max_lun = 0; USB_WriteEP(0x80, &max_lun, 1);
                    } else USB_SetStallEP(0x80);
                    break;
                default: USB_SetStallEP(0x80); break;
            }
        } else {
            uint8_t dummy[64]; USB_ReadEP(0x00, dummy);
        }
    }
}

void BOT_Send_Next_Chunk(void) {
    if (Bulk_Data_Len > 0) {
        uint32_t chunk = (Bulk_Data_Len > 64) ? 64 : Bulk_Data_Len;
        if (Bulk_Data_Ptr != 0) {
            USB_WriteEP(0x81, (uint8_t *)Bulk_Data_Ptr, chunk);

            // Advance physical pointer by 2x the logical chunk size if in SDRAM
            if ((uint32_t)Bulk_Data_Ptr >= 0xA0000000) Bulk_Data_Ptr += (chunk * 2);
            else Bulk_Data_Ptr += chunk;

        } else {
            uint8_t zeroes[64] = {0};
            USB_WriteEP(0x81, zeroes, chunk);
        }
        Bulk_Data_Len -= chunk;
        Actual_Transferred_Len += chunk;
    } else if (Bulk_Sending_Data) {
        Bulk_Sending_Data = false;
        csw.dCSWDataResidue = Expected_Transfer_Len - Actual_Transferred_Len;
        USB_WriteEP(0x81, (uint8_t *)&csw, 13);
    }
}

void Process_Bulk_OUT(void) {
    if (Bulk_Expecting_Write_Data) {
        uint8_t temp[64];
        uint32_t count;

        if (Write_Data_Ptr != 0) {
            count = USB_ReadEP(0x02, (uint8_t *)Write_Data_Ptr);

            // Advance physical pointer by 2x the logical count if in SDRAM
            if ((uint32_t)Write_Data_Ptr >= 0xA0000000) Write_Data_Ptr += (count * 2);
            else Write_Data_Ptr += count;

        } else {
            count = USB_ReadEP(0x02, temp);
        }

        if (Write_Data_Len > count) Write_Data_Len -= count;
        else Write_Data_Len = 0;

        Actual_Transferred_Len += count;

        if (Write_Data_Len == 0) {
            Bulk_Expecting_Write_Data = false;
            csw.bCSWStatus = 0;
            csw.dCSWDataResidue = Expected_Transfer_Len - Actual_Transferred_Len;
            USB_WriteEP(0x81, (uint8_t *)&csw, 13);

            if (writing_lba0) {
                UART0_Print("\r\n[USB] LBA 0 Write Complete!\r\n");
                writing_lba0 = false;
            }
        }
        return;
    }

    uint32_t count = USB_ReadEP(0x02, (uint8_t *)&cbw);
    if (count == 31 && cbw.dCBWSignature == 0x43425355) {
        csw.dCSWSignature = 0x53425355;
        csw.dCSWTag = cbw.dCBWTag;
        csw.bCSWStatus = 0;
        Expected_Transfer_Len = cbw.dCBWDataTransferLength;
        Actual_Transferred_Len = 0;

        switch (cbw.CBWCB[0]) {
            case 0x00:
                csw.dCSWDataResidue = 0;
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
            case 0x03:
                Bulk_Data_Ptr = (volatile uint8_t *)SCSI_Sense_Data;
                Bulk_Data_Len = sizeof(SCSI_Sense_Data);
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            case 0x12:
                Bulk_Data_Ptr = (volatile uint8_t *)SCSI_Inquiry_Data;
                Bulk_Data_Len = sizeof(SCSI_Inquiry_Data);
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            case 0x1A:
                Bulk_Data_Ptr = (volatile uint8_t *)SCSI_Mode_Data;
                Bulk_Data_Len = sizeof(SCSI_Mode_Data);
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            case 0x25:
                Bulk_Data_Ptr = (volatile uint8_t *)SCSI_Capacity_Data;
                Bulk_Data_Len = 8;
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;

            case 0x28: // READ
            {
                uint32_t lba = (cbw.CBWCB[2] << 24) | (cbw.CBWCB[3] << 16) | (cbw.CBWCB[4] << 8) | cbw.CBWCB[5];
                uint16_t blocks = (cbw.CBWCB[7] << 8) | cbw.CBWCB[8];

                // 512 logical bytes = 1024 physical bytes
                uint32_t physical_offset = lba * 1024;

                if (lba == 0) {
                    UART0_Print("\r\n[USB] Host READ LBA 0.\r\n");
                }

                if ((physical_offset + (blocks * 1024)) <= SDRAM_DISK_SIZE) Bulk_Data_Ptr = &SDRAM_Disk[physical_offset];
                else Bulk_Data_Ptr = 0;

                Bulk_Data_Len = blocks * 512;
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            }

            case 0x2A: // WRITE
            {
                uint32_t lba = (cbw.CBWCB[2] << 24) | (cbw.CBWCB[3] << 16) | (cbw.CBWCB[4] << 8) | cbw.CBWCB[5];
                uint16_t blocks = (cbw.CBWCB[7] << 8) | cbw.CBWCB[8];

                // 512 logical bytes = 1024 physical bytes
                uint32_t physical_offset = lba * 1024;

                if (lba == 0) {
                    UART0_Print("\r\n[USB] Host is WRITING Superblock (LBA 0)\r\n");
                    writing_lba0 = true;
                } else {
                    writing_lba0 = false;
                }

                if ((physical_offset + (blocks * 1024)) <= SDRAM_DISK_SIZE) Write_Data_Ptr = &SDRAM_Disk[physical_offset];
                else Write_Data_Ptr = 0;

                Write_Data_Len = blocks * 512;
                Bulk_Expecting_Write_Data = true;
                break;
            }

            default:
                csw.dCSWDataResidue = Expected_Transfer_Len;
                csw.bCSWStatus = 0x01; // Command Failed Status
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
        }
    }
}
