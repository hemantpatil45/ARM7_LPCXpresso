#include "LPC24xx.h"
#include "usbcore.h"
#include "usbhw.h"
#include "usbdesc.h"
#include <stdbool.h>

extern void UART0_Print(const char *str);
extern void UART_PrintHex(uint32_t val);

USB_SETUP_PACKET SetupPacket;
USB_CBW cbw;
USB_CSW csw;

// ---------------------------------------------------
// Bulk-Only Transport (BOT) Chunking State Machine
// ---------------------------------------------------
uint8_t *Bulk_Data_Ptr;
uint32_t Bulk_Data_Len;
bool Bulk_Sending_Data = false;

// ---------------------------------------------------
// Physical Backing RAM (32 KB)
// ---------------------------------------------------
uint8_t RAM_Disk[32768];

void Init_RAM_Disk(void) {
    for(int i = 0; i < 32768; i++) {
        RAM_Disk[i] = 0;
    }

    // Set standard FAT boot sector markers to satisfy Linux kernel probing
    RAM_Disk[0] = 0xEB;
    RAM_Disk[1] = 0x3C;
    RAM_Disk[2] = 0x90;

    // OEM Name ("LPC2478")
    RAM_Disk[3] = 'L'; RAM_Disk[4] = 'P'; RAM_Disk[5] = 'C';
    RAM_Disk[6] = '2'; RAM_Disk[7] = '4'; RAM_Disk[8] = '7'; RAM_Disk[9] = '8'; RAM_Disk[10] = ' ';

    // Bytes per sector: 512 (0x0200)
    RAM_Disk[11] = 0x00; RAM_Disk[12] = 0x02;

    // Boot signature
    RAM_Disk[510] = 0x55;
    RAM_Disk[511] = 0xAA;
}

// ---------------------------------------------------
// SCSI Constants
// ---------------------------------------------------
const uint8_t SCSI_Inquiry_Data[36] = {
    0x00, 0x80, 0x02, 0x02, 31, 0x00, 0x00, 0x00,
    'L', 'P', 'C', '2', '4', '7', '8', ' ',
    'D', 'e', 'v', 'i', 'c', 'e', ' ', ' ',
    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
    '1', '.', '0', '0'
};

const uint8_t SCSI_Capacity_Data[8] = {
    0x00, 0x00, 0x00, 0x3F, // Last LBA: 63
    0x00, 0x00, 0x02, 0x00  // Block Length: 512 bytes
};

// ---------------------------------------------------
// Hardware FIFO Chunking Handler
// ---------------------------------------------------
void BOT_Send_Next_Chunk(void) {
    if (Bulk_Data_Len > 0) {
        // Send up to 64 bytes at a time
        uint32_t chunk = (Bulk_Data_Len > 64) ? 64 : Bulk_Data_Len;
        USB_WriteEP(0x81, Bulk_Data_Ptr, chunk);
        Bulk_Data_Ptr += chunk;
        Bulk_Data_Len -= chunk;
    } else if (Bulk_Sending_Data) {
        // Data phase complete, send the Status Wrapper (CSW)
        Bulk_Sending_Data = false;
        USB_WriteEP(0x81, (uint8_t *)&csw, 13);
    }
}

// ---------------------------------------------------
// Endpoint 0 Enumeration Engine
// ---------------------------------------------------
void USB_EndPoint0(uint32_t event) {
    uint8_t *pData;
    uint32_t descriptor_size;

    if (event == 0) {
        USB_WriteCmd(CMD_SEL_EP + 0);
        uint32_t ep_stat = USB_ReadCmdData(CMD_SEL_EP + 0);

        if (ep_stat & (1 << 5)) {
            USB_ReadEP(0x00, (uint8_t *)&SetupPacket);

            switch (SetupPacket.bRequest) {
                case USB_REQUEST_SET_ADDRESS:
                    USB_SetAddress(SetupPacket.wValue);
                    USB_WriteEP(0x80, 0, 0);
                    break;

                case USB_REQUEST_GET_DESCRIPTOR:
                    switch (SetupPacket.wValue >> 8) {
                        case 0x01:
                            pData = (uint8_t *)USB_DeviceDescriptor;
                            descriptor_size = 18;
                            break;
                        case 0x02:
                            pData = (uint8_t *)USB_ConfigDescriptor;
                            descriptor_size = 32;
                            break;
                        default:
                            USB_SetStallEP(0x80);
                            return;
                    }
                    if (descriptor_size > SetupPacket.wLength) descriptor_size = SetupPacket.wLength;
                    USB_WriteEP(0x80, pData, descriptor_size);
                    break;

                case USB_REQUEST_SET_CONFIGURATION:
                    USB_Configure(true);
                    USB_ConfigEP(0x81, 64); // EP1 IN
                    USB_EnableEP(0x81);
                    USB_ConfigEP(0x02, 64); // EP2 OUT
                    USB_EnableEP(0x02);
                    EP_INT_EN |= (1 << 3) | (1 << 4);
                    USB_WriteEP(0x80, 0, 0);
                    break;

                case 0xFE: // GET_MAX_LUN
                    if (SetupPacket.bmRequestType == 0xA1) {
                        uint8_t max_lun = 0;
                        USB_WriteEP(0x80, &max_lun, 1);
                    } else {
                        USB_SetStallEP(0x80);
                    }
                    break;

                default:
                    USB_SetStallEP(0x80);
                    break;
            }
        } else {
            uint8_t dummy[64];
            USB_ReadEP(0x00, dummy);
        }
    }
}

// ---------------------------------------------------
// Bulk OUT & SCSI Command Parser
// ---------------------------------------------------
void Process_Bulk_OUT(void) {
    uint32_t count = USB_ReadEP(0x02, (uint8_t *)&cbw);

    // Ensure it is a valid 31-byte CBW
    if (count == 31 && cbw.dCBWSignature == 0x43425355) {
        csw.dCSWSignature = 0x53425355;
        csw.dCSWTag = cbw.dCBWTag;
        csw.dCSWDataResidue = 0;
        csw.bCSWStatus = 0; // Default to Passed

        uint8_t opcode = cbw.CBWCB[0];

        switch (opcode) {
            case 0x00: // TEST UNIT READY
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;

            case 0x03: // REQUEST SENSE
            {
                static uint8_t sense_data[18] = {0x70, 0, 0x05, 0, 0, 0, 0, 10, 0, 0, 0, 0, 0x30, 0x01, 0, 0, 0, 0};
                Bulk_Data_Ptr = sense_data;
                Bulk_Data_Len = 18;
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            }

            case 0x12: // INQUIRY
                Bulk_Data_Ptr = (uint8_t *)SCSI_Inquiry_Data;
                Bulk_Data_Len = sizeof(SCSI_Inquiry_Data);
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;

            case 0x1A: // MODE SENSE (6)
            {
                static uint8_t mode_sense_data[4] = {0x03, 0x00, 0x00, 0x00};
                Bulk_Data_Ptr = mode_sense_data;
                Bulk_Data_Len = 4;
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;
            }

            case 0x25: // READ CAPACITY (10)
                Bulk_Data_Ptr = (uint8_t *)SCSI_Capacity_Data;
                Bulk_Data_Len = sizeof(SCSI_Capacity_Data);
                Bulk_Sending_Data = true;
                BOT_Send_Next_Chunk();
                break;

            case 0x28: // READ (10)
            {
                uint32_t lba = (cbw.CBWCB[2] << 24) | (cbw.CBWCB[3] << 16) | (cbw.CBWCB[4] << 8) | cbw.CBWCB[5];
                uint16_t blocks = (cbw.CBWCB[7] << 8) | cbw.CBWCB[8];
                uint32_t byte_offset = lba * 512;
                uint32_t byte_length = blocks * 512;

                if ((byte_offset + byte_length) <= sizeof(RAM_Disk)) {
                    Bulk_Data_Ptr = &RAM_Disk[byte_offset];
                    Bulk_Data_Len = byte_length;
                    Bulk_Sending_Data = true;
                    BOT_Send_Next_Chunk();
                } else {
                    csw.bCSWStatus = 1;
                    USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                }
                break;
            }

            case 0x2A: // WRITE (10)
            {
                // Placeholder: Accept the command to keep the host happy,
                // but drop the data until we implement the Write chunking machine.
                csw.bCSWStatus = 0;
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
            }

            default:
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
        }
    }
}
