#include "LPC24xx.h"
#include "usbhw.h"

#define UART0_BAUD 115200
#define CCLK_FREQ  48000000
#define PCLK_DIV   4
#define Fpclk      (CCLK_FREQ / PCLK_DIV)

// External system clock initialization functions
extern void PLL_Init(void);

extern void system_Init(void);

// Simple function to print hex values over UART0
void UART_PrintHex(uint32_t val) {
    char buf[11];
    buf[0] = '0';
    buf[1] = 'x';
    for (int i = 7; i >= 0; i--) {
        uint8_t nibble = (val >> (i * 4)) & 0x0F;
        buf[9 - i] = (nibble < 10) ? ('0' + nibble) : ('A' + nibble - 10);
    }
    buf[10] = '\0';
    UART0_Print(buf);
}

// Dump critical USB and Clock registers to UART0
void Check_USB_Registers(void) {
    UART0_Print("\r\n--- LPC2478 USB Register Diagnostic ---\r\n");

    UART0_Print("PCONP (Power Control): ");
    UART_PrintHex(PCONP);
    UART0_Print("\r\n");

    UART0_Print("USBCLKCFG (USB Clock Divider): ");
    UART_PrintHex(USBCLKCFG);
    UART0_Print("\r\n");

    UART0_Print("PINSEL1 (USB D+/D- Pins): ");
    UART_PrintHex(PINSEL1);
    UART0_Print("\r\n");

    UART0_Print("DEV_INT_STAT (Device Interrupt Status): ");
    UART_PrintHex(DEV_INT_STAT);
    UART0_Print("\r\n");

    UART0_Print("----------------------------------------\r\n");
}
void UART0_Init(uint32_t baudrate) {
    uint32_t Fdiv;

    // 1. Enable power to UART0 peripheral
    PCONP |= (1 << 3);

    // 2. Set peripheral clock for UART0 (PCLK_UART0 = CCLK / 4)
    PCLKSEL0 &= ~(3 << 6);

    // 3. Set pins P0.2 (TX) and P0.3 (RX) for UART function
    PINSEL0 &= ~0x000000F0;
    PINSEL0 |=  0x00000050;

    // 4. Set 8-bit mode, 1 stop bit, and enable access to divisor latches (DLAB)
    U0LCR = 0x83;

    // 5. Calculate and set baud rate divisor
    Fdiv = (Fpclk / 16) / baudrate;
    U0DLM = (Fdiv >> 8) & 0xFF;
    U0DLL = Fdiv & 0xFF;

    // 6. Disable fractional divider for standard baud rate stability
    U0FDR = 0x10;

    // 7. Disable DLAB to access data registers
    U0LCR = 0x03;

    // 8. Enable and clear UART transmit/receive FIFOs
    U0FCR = 0x07;
}

// Send a single character over UART
void UART0_SendChar(char ch) {
    while (!(U0LSR & 0x20));
    U0THR = ch;
}

// Send a null-terminated string over UART
void UART0_Print(const char *str) {
    while (*str) {
        UART0_SendChar(*str++);
    }
}

// Send a raw buffer of bytes over UART
void UART0_SendBuffer(const uint8_t *buf, uint32_t len) {
    for (uint32_t k = 0; k < len; k++) {
        while (!(U0LSR & 0x20));
        U0THR = buf[k];
    }
}

void delay_ms(uint32_t ms) {
    for (volatile uint32_t i = 0; i < (ms * 1000); i++);
}

int main(void) {
    // 1. Initialize System Clocks and PLL
    PLL_Init();
    system_Init();

    // 2. Initialize UART0 immediately
    UART0_Init(UART0_BAUD);
    UART0_Print("\r\n[BOOT] Starting...\r\n");

    // 3. Give you time to open your terminal (3-second delay before first message)
    delay_ms(3000);

    UART0_Print("\r\n[BOOT] LPC2478 USB Booting...\r\n");

    delay_ms(100);

    // 4. Initialize USB Subsystem
    UART0_Print("[USB] Initializing USB Engine...\r\n");
    USB_Init();

    UART0_Print("[USB] Connecting to Bus (D+ pull-up)...\r\n");
    USB_Connect(true);

    UART0_Print("[USB] Entering Main Loop.\r\n");

    while (1) {
        // Background loop execution
    }
}
