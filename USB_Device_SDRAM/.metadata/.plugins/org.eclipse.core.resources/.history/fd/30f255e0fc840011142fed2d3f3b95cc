#include "LPC24xx.h"
#include "usbcore.h"
#include "usbhw.h"
#include "usbdesc.h"

extern void UART0_Print(const char *str);
extern void UART_PrintHex(uint32_t val);

USB_SETUP_PACKET SetupPacket;
USB_CBW cbw;
USB_CSW csw;

uint8_t RAM_Disk[32768];

const uint8_t SCSI_Inquiry_Data[36] = {
    0x00, 0x80, 0x02, 0x02, 31, 0x00, 0x00, 0x00,
    'L', 'P', 'C', '2', '4', '7', '8', ' ',
    'D', 'e', 'v', 'i', 'c', 'e', ' ', ' ',
    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
    '1', '.', '0', '0'
};

const uint8_t SCSI_Capacity_Data[8] = {
    0x00, 0x00, 0x00, 0x3F,
    0x00, 0x00, 0x02, 0x00
};

// -----------------------------------------------------------------
// The missing function definition that the linker is looking for:
// -----------------------------------------------------------------
void USB_EndPoint0(uint32_t event) {
    uint8_t *pData;
    uint32_t descriptor_size;

    if (event == 0) {
        USB_WriteCmd(CMD_SEL_EP + 0);
        uint32_t ep_stat = USB_ReadCmdData(CMD_SEL_EP + 0);

        if (ep_stat & (1 << 5)) {
            USB_ReadEP(0x00, (uint8_t *)&SetupPacket);

            switch (SetupPacket.bRequest) {
                case USB_REQUEST_SET_ADDRESS:
                    USB_SetAddress(SetupPacket.wValue);
                    USB_WriteEP(0x80, 0, 0);
                    break;

                case USB_REQUEST_GET_DESCRIPTOR:
                    switch (SetupPacket.wValue >> 8) {
                        case 0x01:
                            pData = (uint8_t *)USB_DeviceDescriptor;
                            descriptor_size = 18;
                            break;
                        case 0x02:
                            pData = (uint8_t *)USB_ConfigDescriptor;
                            descriptor_size = 32;
                            break;
                        default:
                            USB_SetStallEP(0x80);
                            return;
                    }

                    if (descriptor_size > SetupPacket.wLength) {
                        descriptor_size = SetupPacket.wLength;
                    }
                    USB_WriteEP(0x80, pData, descriptor_size);
                    break;

                case USB_REQUEST_SET_CONFIGURATION:
                    USB_Configure(true);
                    USB_ConfigEP(0x81, 64);
                    USB_EnableEP(0x81);
                    USB_ConfigEP(0x02, 64);
                    USB_EnableEP(0x02);
                    EP_INT_EN |= (1 << 3) | (1 << 4);
                    USB_WriteEP(0x80, 0, 0);
                    break;

                case 0xFE:
                    if (SetupPacket.bmRequestType == 0xA1) {
                        uint8_t max_lun = 0;
                        USB_WriteEP(0x80, &max_lun, 1);
                    } else {
                        USB_SetStallEP(0x80);
                    }
                    break;

                default:
                    USB_SetStallEP(0x80);
                    break;
            }
        } else {
            uint8_t dummy[64];
            USB_ReadEP(0x00, dummy);
        }
    }
}

void Process_Bulk_OUT(void) {
    uint32_t count = USB_ReadEP(0x02, (uint8_t *)&cbw);

    if (count == 31 && cbw.dCBWSignature == 0x43425355) {
        UART0_Print("[SCSI] Valid CBW Opcode: ");
        UART_PrintHex(cbw.CBWCB[0]);
        UART0_Print("\r\n");

        csw.dCSWSignature = 0x53425355; // "USBS"
        csw.dCSWTag = cbw.dCBWTag;
        csw.dCSWDataResidue = 0;
        csw.bCSWStatus = 0; // Default to Passed

        uint8_t opcode = cbw.CBWCB[0];

        switch (opcode) {
            case 0x12: // SCSI INQUIRY
                UART0_Print("[SCSI] Responding to INQUIRY...\r\n");
                USB_WriteEP(0x81, (uint8_t *)SCSI_Inquiry_Data, sizeof(SCSI_Inquiry_Data));
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;

            case 0x25: // SCSI READ CAPACITY (10)
                UART0_Print("[SCSI] Responding to READ CAPACITY (32KB)...\r\n");
                USB_WriteEP(0x81, (uint8_t *)SCSI_Capacity_Data, sizeof(SCSI_Capacity_Data));
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;

            case 0x28: // SCSI READ (10)
            {
                uint32_t lba = (cbw.CBWCB[2] << 24) | (cbw.CBWCB[3] << 16) |
                               (cbw.CBWCB[4] << 8)  | cbw.CBWCB[5];
                uint16_t blocks = (cbw.CBWCB[7] << 8) | cbw.CBWCB[8];

                uint32_t byte_offset = lba * 512;
                uint32_t byte_length = blocks * 512;

                UART0_Print("[SCSI] READ LBA: ");
                UART_PrintHex(lba);
                UART0_Print(" Blocks: ");
                UART_PrintHex(blocks);
                UART0_Print("\r\n");

                if ((byte_offset + byte_length) <= sizeof(RAM_Disk)) {
                    USB_WriteEP(0x81, &RAM_Disk[byte_offset], byte_length);
                    csw.bCSWStatus = 0;
                } else {
                    csw.bCSWStatus = 1; // Failed
                }

                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
            }

            // ---------------------------------------------------
            // NEW: Explicit TEST UNIT READY
            // ---------------------------------------------------
            case 0x00:
                UART0_Print("[SCSI] TEST UNIT READY -> OK\r\n");
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;

            // ---------------------------------------------------
            // NEW: REQUEST SENSE (Prevents driver lockups)
            // ---------------------------------------------------
            case 0x03:
            {
                UART0_Print("[SCSI] REQUEST SENSE -> Sending No Errors\r\n");
                // Standard 18-byte sense data (No sense / success)
                uint8_t sense_data[18] = {0x70, 0, 0x05, 0, 0, 0, 0, 10, 0, 0, 0, 0, 0x30, 0x01, 0, 0, 0, 0};
                USB_WriteEP(0x81, sense_data, 18);
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
            }

            case 0x1A: // MODE SENSE 6
            default:
                USB_WriteEP(0x81, (uint8_t *)&csw, 13);
                break;
        }
    }
}
