int main()
{
    PLL_Init();
    system_Init();
    GLCD_Init();
    GLCD_Clear();

    // 1. Bring up the external memory controller and SDRAM chip
    SDRAM_init_32BIT();

    // 2. Format the physical SDRAM space with a boot sector signature
    SDRAM_Disk_Format();

    GLCD_RowWriteMargin(0, "SDRAM USB MSC DRIVE ");
    GLCD_RowWriteMargin(1, "READY FOR PC LINK   ");

    // 3. Initialize and connect your USB Stack here
    // USB_Init();
    // USB_Connect(1);

    while (1)
    {
        // Background loop (USB packets are handled asynchronously via interrupts)
    }
