#include "system_init.h"
#include "LPC24xx.h"
#include <stdint.h>

// Updated to 48u to match the 48 MHz CCLK generated by the Set 1 PLL configuration
#define CCLK_MHZ    48u

void delay_us(uint32_t us)
{
    volatile uint32_t n = us * CCLK_MHZ;
    while(n--) __asm__("nop");
}

void delay_cycles(uint32_t cycles)
{
    while(cycles--) __asm__("nop");
}

void PLL_Init(void)
{
    MEMMAP = 0x01;  // Interrupts mapped to User Flash

    // 1. Enable Main Oscillator (12 MHz) and set fast IO access on Ports 0 & 1
    SCS |= 0x20;
    while (!(SCS & 0x40)); // Wait for main oscillator stabilization

    // 2. Select Main Oscillator as clock source for PLL
    CLKSRCSEL = 0x01;

    // 3. Configure PLL Multiplier/Divider: M=12, N=1
    // FCCO = (2 * M * FIN) / N = (2 * 12 * 12 MHz) / 1 = 288 MHz
    PLLCFG = 0x0000000B;
    PLLFEED = 0xAA;
    PLLFEED = 0x55;

    // 4. Enable PLL
    PLLCON = 0x01;
    PLLFEED = 0xAA;
    PLLFEED = 0x55;

    // 5. Set CCLK Divider to 6 (288 MHz / 6 = 48 MHz CCLK)
    CCLKCFG = 0x05;

    // 6. Wait for PLL Lock
    while (!(PLLSTAT & (1 << 26)));

    // 7. Connect PLL as CCLK source
    PLLCON = 0x03;
    PLLFEED = 0xAA;
    PLLFEED = 0x55;

    // 8. Configure Peripheral Clocks (PCLK = CCLK / 4)
    PCLKSEL0 = 0x00000000;
    PCLKSEL1 = 0x00000000;
}

void system_Init(void)
{
    SCS |= (1 << 0);

//*********************** SET PINSEL FOR UART0 ***********************
    PINSEL0 &= ~(3UL << 4);
    PINSEL0 |=  (1UL << 4); // M_USB_TXD P0[2]
    PINSEL0 &= ~(3UL << 6);
    PINSEL0 |=  (1UL << 6); // M_USB_RXD P0[3]

//*********************** SET PINSEL TO CAN DEVICE ***********************
    PINSEL0 &= ~(3UL << 0);
    PINSEL0 |=  (1UL << 0); // M_RD1 P0[0]
    PINSEL0 &= ~(3UL << 2);
    PINSEL0 |=  (1UL << 2); // M_TD1 P0[1]

//*********************** SET DIRECTION TO GLCD ***********************
    PINSEL0 &= ~(3UL << 8);   // LCD_RS P0[4]
    PINSEL0 &= ~(3UL << 10);  // LCD_RW P0[5]
    PINSEL0 &= ~(3UL << 12);  // LCD_E  P0[6]
    PINSEL0 &= ~(3UL << 14);  // LCD_DB0 P0[7]
    PINSEL0 &= ~(3UL << 16);  // LCD_DB1 P0[8]
    PINSEL0 &= ~(3UL << 18);  // LCD_DB2 P0[9]
    PINSEL3 &= ~(3UL << 8);   // LCD_DB3 P1[20]
    PINSEL3 &= ~(3UL << 10);  // LCD_DB4 P1[21]
    PINSEL3 &= ~(3UL << 14);  // LCD_DB5 P1[23]
    PINSEL3 &= ~(3UL << 16);  // LCD_DB6 P1[24]
    PINSEL3 &= ~(3UL << 18);  // LCD_DB7 P1[25]
    PINSEL3 &= ~(3UL << 20);  // LCD_CS1 P1[26]
    PINSEL0 &= ~(3UL << 28);  // LCD_CS2 P0[14]

//*********************** RELAY & BUZZER ***********************
    PINSEL0 &= ~(3UL << 20);  // RELAY_BUZZER P0[10]

//*********************** KEYBOARD PINS ***********************
    PINSEL4 &= ~(3UL << 0);   // KEYBOARD0 P2[0]
    PINSEL4 &= ~(3UL << 2);   // KEYBOARD1 P2[1]
    PINSEL5 &= ~(3UL << 12);  // KEYBOARD2 P2[22]
    PINSEL5 &= ~(3UL << 14);  // KEYBOARD3 P2[23]
    PINSEL5 &= ~(3UL << 18);  // KEYBOARD4 P2[25]
    PINSEL5 &= ~(3UL << 20);  // KEYBOARD5 P2[26]
    PINSEL5 &= ~(3UL << 22);  // KEYBOARD6 P2[27]
    PINSEL0 &= ~(3UL << 22);  // KEYBOARD7 P0[11]

//*********************** SPI & SD CARD ***********************
    PINSEL1 &= ~(3UL << 6);   // SD_CLOCK P0[19]
    PINSEL1 &= ~(3UL << 8);   // M_SPI_SSEL P0[20]
    PINSEL1 &= ~(3UL << 12);  // M_SPI_MISO P0[22]
    PINSEL4 &= ~(3UL << 22);  // M_SPI_MOSI P2[11]
    PINSEL2 &= ~(3UL << 22);  // M_SPI_MOSI P1[11]
    PINSEL2 &= ~(3UL << 24);  // SD_CS P1[12]

//*********************** INTERNAL ADC & DAC ***********************
    PINSEL1 &= ~(3UL << 14);  // M_ADC_CH0 P0[23]
    PINSEL1 |=  (1UL << 14);
    PINSEL1 &= ~(3UL << 20);  // M_DAC_OUT P0[26]
    PINSEL1 |=  (2UL << 20);

//*********************** EXTERNAL ADC PINS ***********************
    PINSEL7 &= ~(3UL << 0);   // P3[16]
    PINSEL7 &= ~(3UL << 2);   // P3[17]
    PINSEL7 &= ~(3UL << 4);   // P3[18]
    PINSEL7 &= ~(3UL << 6);   // P3[19]
    PINSEL7 &= ~(3UL << 8);   // P3[20]
    PINSEL7 &= ~(3UL << 10);  // P3[21]
    PINSEL7 &= ~(3UL << 12);  // P3[22]
    PINSEL7 &= ~(3UL << 14);  // P3[23]
    PINSEL7 &= ~(3UL << 16);  // P3[24]
    PINSEL7 &= ~(3UL << 18);  // P3[25]
    PINSEL7 &= ~(3UL << 20);  // P3[26]
    PINSEL7 &= ~(3UL << 22);  // P3[27]
    PINSEL7 &= ~(3UL << 24);  // P3[28]
    PINSEL7 &= ~(3UL << 26);  // P3[29]
    PINSEL7 &= ~(3UL << 28);  // P3[30]

//*********************** EXTERNAL DAC PINS ***********************
    PINSEL4 &= ~(3UL << 28);  // M_DAC_CS#
    PINSEL1 &= ~(3UL << 18);  // M_DAC_CLR# P0[25]
    PINSEL2 &= ~(3UL << 14);  // M_DAC_LD# P1[7]

//*********************** SPI PINS ***********************
    PINSEL0 &= ~(3UL << 30);  // SCK P0[15]
    PINSEL0 |=  (2UL << 30);
    PINSEL1 &= ~(3UL << 0);   // SSEL P0[16]
    PINSEL1 |=  (2UL << 0);
    PINSEL1 &= ~(3UL << 2);   // MISO P0[17]
    PINSEL1 |=  (2UL << 2);
    PINSEL1 &= ~(3UL << 4);   // MOSI P0[18]
    PINSEL1 |=  (2UL << 4);

//*********************** I2C PINS ***********************
    PINSEL1 &= ~(3UL << 22);  // SDA P0[27]
    PINSEL1 |=  (1UL << 22);
    PINSEL1 &= ~(3UL << 24);  // SCL P0[28]
    PINSEL1 |=  (1UL << 24);

//*********************** MOTOR PINS ***********************
    PINSEL1 &= ~(3UL << 10);  // M_MOTOR_EN_A P0[21]
    PINSEL1 &= ~(3UL << 16);  // M_MOTOR_EN_B P0[24]
    PINSEL2 &= ~(3UL << 4);   // P1[2]
    PINSEL2 &= ~(3UL << 6);   // P1[3]
    PINSEL2 &= ~(3UL << 10);  // P1[15]
    PINSEL2 &= ~(3UL << 12);  // P1[16]

//*********************** LEDS 0 TO 3 ***********************
    PINSEL4 &= ~(3UL << 30);  // P2.15
    PINSEL5 &= ~(3UL << 6);   // P2.19
    PINSEL5 &= ~(3UL << 10);  // P2.21
    PINSEL2 &= ~(3UL << 26);  // P1.13

//*********************** SWITCHES 0 TO 3 ***********************
    PINSEL9 &= ~(3UL << 14);  // Switch 0 P4[23]
    PINSEL9 &= ~(3UL << 20);  // Switch 1 P4[26]
    PINSEL9 &= ~(3UL << 22);  // Switch 2 P4[27]
    PINSEL9 &= ~(3UL << 30);  // Switch 3 P4[31]

//*********************** EXTERNAL INTERRUPT ***********************
    PINSEL4 &= ~(3UL << 20);  // EINT0# P2[10]
    PINSEL4 |=  (1UL << 20);

//*********************** ETHERNET ***********************
    PINSEL2 &= ~(3UL << 0);  PINSEL2 |= (1UL << 0);  // ENET_TXD0
    PINSEL2 &= ~(3UL << 2);  PINSEL2 |= (1UL << 2);  // ENET_TXD1
    PINSEL2 &= ~(3UL << 8);  PINSEL2 |= (1UL << 8);  // ENET_TX_EN
    PINSEL2 &= ~(3UL << 30); PINSEL2 |= (1UL << 30); // ENET_RX_CLK
    PINSEL2 &= ~(3UL << 16); PINSEL2 |= (1UL << 16); // ENET_CRS
    PINSEL2 &= ~(3UL << 18); PINSEL2 |= (1UL << 18); // ENET_RXD0
    PINSEL2 &= ~(3UL << 20); PINSEL2 |= (1UL << 20); // ENET_RXD1
    PINSEL2 &= ~(3UL << 28); PINSEL2 |= (1UL << 28); // ENET_RX_ER
    PINSEL3 &= ~(3UL << 0);  PINSEL3 |= (1UL << 0);  // ENET_MDC
    PINSEL3 &= ~(3UL << 2);  PINSEL3 |= (1UL << 2);  // ENET_MDIO

//*********************** USB INTERFACES ***********************
    PINSEL0 &= ~(3UL << 24); PINSEL0 |= (1UL << 24); // USB_PPWR2
    PINSEL0 &= ~(3UL << 26); PINSEL0 |= (1UL << 26); // USB_UP_LED2
    PINSEL0 &= ~(3UL << 28); // VBUS P0[14]
    PINSEL1 &= ~(3UL << 30); PINSEL1 |= (1UL << 30); // USB_D+2
    PINSEL3 &= ~(3UL << 28); PINSEL3 |= (1UL << 28); // USB_PWRD2
    PINSEL3 &= ~(3UL << 30); PINSEL3 |= (1UL << 30); // USB_OVRCR2#

    PINSEL1 &= ~(3UL << 26); PINSEL1 |= (1UL << 26); // USB_D+1
    PINSEL1 &= ~(3UL << 28); PINSEL1 |= (1UL << 28); // USB_D-1
    PINSEL2 &= ~(3UL << 16); PINSEL2 |= (1UL << 16); // USB_UP-LED
    PINSEL2 &= ~(3UL << 18); PINSEL2 |= (1UL << 18); // USB_1 CONNECT

//*********************** PINMODE & DIRECTION REGISTERS ***********************
    PINMODE0 = 0x00000000;
    PINMODE1 = 0x00000000;
    PINMODE2 = 0x00000000;
    PINMODE3 = 0x00000000;
    PINMODE4 = 0x00000000;
    PINMODE5 = 0xAA02022A;
    PINMODE6 = 0xAAAAAAAA;
    PINMODE7 = 0xAAAAAAAA;
    PINMODE8 = 0xAAAAAAAA;
    PINMODE9 = 0x200A2AAA;

    FIO0DIR = 0x03784FF0;
    FIO1DIR = 0x3FF038EC;
    FIO2DIR = 0x0EE8F3FC;
    FIO3DIR = 0x70000000;
    FIO4DIR = 0x30000000;

    FIO0SET = 0x02004000;
    FIO1SET = 0x00003080;
    FIO2SET = 0x0028C000;
    FIO3SET = 0x70000000;
    FIO4SET = 0x00000000;

    FIO0CLR = 0x01780FF0;
    FIO1CLR = 0x3FF0086C;
    FIO2CLR = 0x0EC03BFC;
    FIO3CLR = 0x00000000;
    FIO4CLR = 0x30000000;

    FIO0MASK = 0;
    FIO1MASK = 0;
    FIO2MASK = 0;
    FIO3MASK = 0;
    FIO4MASK = 0;

    FIO1DIR |= (1 << 22);
    FIO0DIR |= (1 << 4) | (1 << 5) | (1 << 6) | (1 << 7) | (1 << 8) | (1 << 9);
    FIO1DIR |= (1 << 20) | (1 << 21) | (1 << 23) | (1 << 24) | (1 << 25) | (1 << 26);
    FIO0DIR |= (1 << 28);
}
