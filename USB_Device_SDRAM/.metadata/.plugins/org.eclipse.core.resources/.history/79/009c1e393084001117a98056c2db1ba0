#include "LPC24xx.H"
#include "usbhw.h"
#include "usbcore.h" // Needed so we know about USB_EndPoint0

// --- LPC2478 USB Protocol Engine Command Codes ---
#define CMD_SET_ADDR        0xD0
#define CMD_CFG_DEV         0xD8
#define CMD_SET_DEV_STAT    0xFE
#define CMD_GET_DEV_STAT    0xFE
#define CMD_CLR_BUF         0xF2
#define CMD_VALID_BUF       0xFA
#define CMD_SEL_EP          0x00
#define CMD_SET_EP_STAT     0x40

// --- Protocol Engine Helper Functions ---

void USB_WriteCmd(uint32_t cmd) {
    DEV_INT_CLR = 0x10;
    CMD_CODE = (cmd << 16) | 0x0500;
    while ((DEV_INT_STAT & 0x10) == 0);
    DEV_INT_CLR = 0x10;
}

void USB_WriteCmdData(uint32_t cmd, uint32_t data) {
    USB_WriteCmd(cmd);
    CMD_CODE = (data << 16) | 0x0100;
    while ((DEV_INT_STAT & 0x10) == 0);
    DEV_INT_CLR = 0x10;
}

uint32_t EPAdrToPhys(uint32_t EPNum) {
    uint32_t dir = (EPNum & 0x80) ? 1 : 0;
    return ((EPNum & 0x0F) * 2) + dir;
}

// --- Setup & Connection ---

void USB_Init(void) {
    PCONP |= (1 << 31);

    USBCLKCFG = 5;

    PINSEL1 &= ~((3 << 26) | (3 << 28));
    PINSEL1 |=  ((1 << 26) | (1 << 28));

    PINSEL3 &= ~(3 << 28);
    PINSEL3 |=  (2 << 28);

    // GoodLink LED config on P1.18
    PINSEL3 &= ~(3 << 4);
    PINSEL3 |=  (1 << 4);

    PINSEL4 &= ~(3 << 18);
    PINSEL4 |=  (1 << 18);
    PINMODE3 &= ~(3 << 28);

    DEV_INT_CLR = 0x3FFF;
    EP_INT_CLR  = 0xFFFFFFFF;

    USB_ConfigEP(0x00, 64);
    USB_ConfigEP(0x80, 64);

    EP_INT_EN = 0x00000003;
    DEV_INT_EN = (1 << 0) | (1 << 1);
    VICIntEnable |= (1 << 22);
}

void USB_Connect(bool connect) {
    USB_WriteCmdData(CMD_SET_DEV_STAT, connect ? 1 : 0);
}

// --- Hardware Engine Control ---

void USB_SetAddress(uint32_t adr) {
    USB_WriteCmdData(CMD_SET_ADDR, adr | 0x80);
}

void USB_Configure(bool configure) {
    USB_WriteCmdData(CMD_CFG_DEV, configure ? 1 : 0);
}

void USB_ConfigEP(uint32_t EPNum, uint32_t MaxPacketSize) {
    uint32_t phys_ep = EPAdrToPhys(EPNum);

    REALIZE_EP |= (1 << phys_ep);
    EP_INDEX = phys_ep;
    MAXPACKET_SIZE = MaxPacketSize;

    while ((DEV_INT_STAT & (1 << 4)) == 0);
    DEV_INT_CLR = (1 << 4);
}

void USB_EnableEP(uint32_t EPNum) {
    EP_INT_EN |= (1 << EPAdrToPhys(EPNum));
}

void USB_DisableEP(uint32_t EPNum) {
    uint32_t phys_ep = EPAdrToPhys(EPNum);
    EP_INT_EN &= ~(1 << phys_ep);
    REALIZE_EP &= ~(1 << phys_ep);
}

void USB_SetStallEP(uint32_t EPNum) {
    USB_WriteCmdData(CMD_SET_EP_STAT + EPAdrToPhys(EPNum), 1);
}

void USB_ClrStallEP(uint32_t EPNum) {
    USB_WriteCmdData(CMD_SET_EP_STAT + EPAdrToPhys(EPNum), 0);
}

// --- Data Transfer Functions ---

uint32_t USB_ReadEP(uint32_t EPNum, uint8_t *pData) {
    uint32_t phys_ep = EPAdrToPhys(EPNum);
    USB_WriteCmd(CMD_SEL_EP + phys_ep);

    uint32_t numBytes = RX_PLENGTH & 0x3FF;
    uint32_t *pDst = (uint32_t *)pData;

    for (uint32_t i = 0; i < (numBytes + 3) / 4; i++) {
        *pDst++ = RX_DATA;
    }

    USB_WriteCmd(CMD_SEL_EP + phys_ep);
    USB_WriteCmd(CMD_CLR_BUF);

    return numBytes;
}

uint32_t USB_WriteEP(uint32_t EPNum, uint8_t *pData, uint32_t cnt) {
    uint32_t phys_ep = EPAdrToPhys(EPNum);
    USB_WriteCmd(CMD_SEL_EP + phys_ep);

    TX_PLENGTH = cnt;
    uint32_t *pSrc = (uint32_t *)pData;

    for (uint32_t i = 0; i < (cnt + 3) / 4; i++) {
        TX_DATA = *pSrc++;
    }

    USB_WriteCmd(CMD_SEL_EP + phys_ep);
    USB_WriteCmd(CMD_VALID_BUF);

    return cnt;
}

// --- Interrupt Service Routine ---

void USB_ISR(void) {
    uint32_t disr = DEV_INT_STAT;
    uint32_t episr = EP_INT_STAT;

    // 1. Handle Device Status Interrupts (like Bus Reset)
    if (disr & (1 << 0)) {
        DEV_INT_CLR = (1 << 0);

        USB_WriteCmd(CMD_GET_DEV_STAT);
        uint32_t dev_stat = CMD_DATA;

        if (dev_stat & (1 << 4)) {
            USB_ConfigEP(0x00, 64);
            USB_ConfigEP(0x80, 64);
            USB_SetAddress(0);
        }
    }

    // 2. Handle Endpoint 0 Interrupts
    if (disr & (1 << 1)) {

        if (episr & (1 << 0)) { // EP0 OUT
            EP_INT_CLR = (1 << 0);
            USB_EndPoint0(0);
        }

        if (episr & (1 << 1)) { // EP0 IN
            EP_INT_CLR = (1 << 1);
            USB_EndPoint0(1);
        }
    }

    // Acknowledge the hardware VIC
    VICVectAddr = 0;
}
