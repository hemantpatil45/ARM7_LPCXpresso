#include <stdint.h>
#include "LPC24xx.h"
#include "glcd.h"
#include "system_init.h"
#include "DAC8512.h"

#define CCLK_HZ 72000000u
#define CCLK_MHZ 72u
#define STEP_US 10u         // Update period for DAC, microseconds (10us)

void dac8512_ssp0_init(void){
    // SCK, MISO, MOSI setup
    PINSEL0 |= (2UL << 30);  // P0.15: SSP0 SCK
    PINSEL1 |= (2UL << 2);   // P0.17: SSP0 MISO
    PINSEL1 |= (2UL << 4);   // P0.18: SSP0 MOSI

    // Set P0.16 (CS/SSEL) as GPIO, not Hardware SSP
    PINSEL1 &= ~(3UL << 0);  // Clear bits to set to GPIO
    IODIR0 |= (1UL << 16);   // Set P0.16 as Output
    IOSET0 |= (1UL << 16);   // Default CS HIGH

    PCONP |= (1u << 21);     // Power Control for SSP0

    // CRITICAL FIX: Set SSP0 PCLK to CCLK (72MHz) so our bit-rate math works
    PCLKSEL1 &= ~(3u << 10);
    PCLKSEL1 |=  (1u << 10);

    // SUCCESS: 11 (which is 11u << 0) configures 12-bit transfer mode
    // (LPC24xx DSS: 0x0B = 12-bit, 0x0F = 16-bit)
    SSP0CR0 = (11u << 0) | (0u << 4) | (0u << 6) | (0u << 7);

    SSP0CR1 = (1u << 1);     // Enable SSP0
    SSP0CPSR = 2;            // Prescaler = 2
    SSP0CR0 |= (35u << 8);   // SCR = 35 -> Bit Rate = 72MHz / (2 * (1 + 35)) = 1MHz
}

void dac8512_write(uint16_t code12){
    // Ensure 12-bit limit (0 to 4095)
    if(code12 > 4095u) code12 = 4095u;

    M_DAC_CS_ON;             // Pull CS Low

    // SUCCESS: Send only the raw 12 bits. The SSP peripheral handles alignment.
    SSP0DR = code12;

    // Wait for SPI transfer to finish (BSY bit)
    while (SSP0SR & (1u << 4));

    M_DAC_CS_OFF;            // Pull CS High

    // Load the DAC latch to update analog output
    M_DAC_LD_ON;
    delay_cycles(100);
    M_DAC_LD_OFF;
}
void timer0_init_us(void){
    PCONP |= (1u << 1);             /* power TIMER0 */
    PCLKSEL0 &= ~(3u << 2);
    PCLKSEL0 |=  (1u << 2);         /* PCLK = CCLK (72MHz) */

    T0PR = (CCLK_HZ / 1000000u) - 1u; // Prescale to 1us tick: 71

    T0MR0 = STEP_US;                 // Match after 10us (10 * 1us ticks)
    T0MCR = (1u << 0) | (1u << 1);  /* Interrupt + Reset on Match (MR0I, MR0R) */
    T0TCR = (1u << 1);               /* Reset Counter */
    T0TCR = (1u << 0);               /* Enable Counter */
}

void timer0_wait_match0(void){
    while ((T0IR & 1u) == 0u) { /* wait for MR0 interrupt flag */ }
    T0IR = 1u; // Clear MR0 interrupt flag
}
