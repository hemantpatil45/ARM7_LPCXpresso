#include <stdint.h>
#include "LPC24xx.h"
#include "system_init.h"
#include "glcd.h"
#include "flashwrite.h"

/* small delay */
static inline void delay_ms(uint32_t ms){ volatile uint32_t n; while(ms--) for(n=0;n<72000;n++) __asm__("nop"); }

/* UART0 basic */
static void UART0_Init(uint32_t cclk){
    PCONP |= (1<<3);
    PCLKSEL0 = (PCLKSEL0 & ~(3<<6)) | (1<<6);     // PCLK = CCLK
    PINSEL0  = (PINSEL0 & ~((3<<4)|(3<<6))) | ((1<<4)|(1<<6)); // TXD0,RXD0
    U0LCR = 0x83;
    uint32_t div = cclk/(16*9600);
    U0DLL = div & 0xFF;
    U0DLM = (div>>8)&0xFF;
    U0LCR = 0x03;
}
static void UART0_PutC(char c){ while(!(U0LSR&(1<<5))); U0THR=c; }
static void UART0_PutS(const char *s){ while(*s){ if(*s=='\n')UART0_PutC('\r'); UART0_PutC(*s++);} }

int main(void)
{
    PLL_Init();
    system_Init();
    GLCD_Init();
    GLCD_Clear();

    GLCD_RowWriteMargin(0,"WELCOME TO AKADEMIKA");
    GLCD_RowWriteMargin(2,"      PL-ARM7       ");
    GLCD_RowWriteMargin(4,"FLASH EXPT          ");
    UART0_Init(72000000);

    flash_hw_init();
    UART0_PutS("System Ready.\nPress SW2 to Erase or SW6 to Write.\n");

    while(1)
    {
        if(SW2_Pressed()){
            GLCD_RowWriteMargin(6,"PRESS SW2 TO ERASE  ");
            flash_erase();
            GLCD_RowWriteMargin(6,"ERASE DONE");
            UART0_PutS("Erase done.\n");
            GLCD_RowWriteMargin(4,"PRESS SW6 TO WRITE   ");

        }

        if(SW6_Pressed()){
            GLCD_RowWriteMargin(6,"WRITING...");
            flash_write_demo();
            GLCD_RowWriteMargin(6,"WRITE DONE");
            UART0_PutS("Write complete.\n");
            flash_uart_dump();
        }
    }
}
