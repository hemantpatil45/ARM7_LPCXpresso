#ifndef FLASHWRITE_H
#define FLASHWRITE_H

#include <stdint.h>

/* ===== NOR Flash base (EMC CS0) ===== */
#define NOR_BASE_ADDR       (0x80000000UL)

/* ===== JEDEC x16 command set (SST39VF3202C) ===== */
#define NOR_UNLOCK1_OFF     (0x555u)     /* word offset on x16 */
#define NOR_UNLOCK2_OFF     (0x2AAu)

#define NOR_CMD_AA          (0x00AAu)
#define NOR_CMD_55          (0x0055u)
#define NOR_CMD_RESET       (0x00F0u)
#define NOR_CMD_PROGRAM     (0x00A0u)
#define NOR_CMD_ERASE_SETUP (0x0080u)
#define NOR_CMD_SECTOR_ERASE (0x0030u)

/* ===== API used by main.c ===== */
void emc_init_cs0_x16(void);                         /* set up EMC + pinmux for CS0 x16 */
void flash_reset(void);                              /* F0 reset */
int  flash_sector_erase(uint32_t byte_addr);         /* erase sector containing byte_addr */
int  flash_write_buf(uint32_t dst_byte_addr,
                     const void *src, uint32_t nbytes); /* program buffer (word by word) */

#endif /* FLASHWRITE_H */

