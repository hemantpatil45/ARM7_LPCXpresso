#ifndef FLASHWRITE_H_
#define FLASHWRITE_H_

#include <stdint.h>

/* ===== Public API (used by main.c) ===== */

/* Keypad: Col1(P2.25) drives LOW to scan; Row1(P2.0)=SW2, Row2(P2.1)=SW6 */
void    Keypad_Col1Row12_Init(void);
uint8_t SW2_Pressed(void);   /* returns 1 when SW2 (Row1/Col1) is pressed (debounced) */
uint8_t SW6_Pressed(void);   /* returns 1 when SW6 (Row2/Col1) is pressed (debounced) */

/* EMC CS0 (x16) setup for NOR */
void emc_init_cs0_x16(void);

/* NOR flash helpers (SST/AMD compatible, x16 on CS0) */
void flash_reset(void);
int  flash_sector_erase(uint32_t byte_addr);                 /* erase sector containing byte_addr */
int  flash_write_buf(uint32_t dst_byte_addr, const void *src, uint32_t nbytes);

/* Expose NOR base if main wants to read back directly */
#define NOR_BASE_ADDR   (0x80000000UL)

#endif /* FLASHWRITE_H_ */
