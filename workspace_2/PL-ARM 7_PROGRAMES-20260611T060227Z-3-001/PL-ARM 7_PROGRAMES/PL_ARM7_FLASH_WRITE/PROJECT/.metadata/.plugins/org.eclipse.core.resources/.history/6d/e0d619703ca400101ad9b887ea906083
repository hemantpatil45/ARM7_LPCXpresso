#include "LPC24xx.h"
#include "flashwrite.h"

/* ============================================================
 *   NOR Flash Base + EMC Register Definitions
 * ============================================================ */
#define NOR_BASE        (0x80000000UL)
#define F16(off)        (*((volatile uint16_t*)(NOR_BASE) + (off)))
#define UNLOCK1         0x555
#define UNLOCK2         0x2AA

//#define EMC_BASE_ADDR   (0xFFE08000UL)
#define EMCControl          (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x000))
#define EMCConfig           (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x008))
#define EMCStaticConfig0    (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x200))
#define EMCStaticWaitWen0   (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x204))
#define EMCStaticWaitOen0   (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x208))
#define EMCStaticWaitRd0    (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x20C))
#define EMCStaticWaitWr0    (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x214))
#define EMCStaticWaitTurn0  (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x218))

static void delay_loops(volatile uint32_t n){ while(n--) __asm__("nop"); }

/* ============================================================
 *   Keypad  (Col1 = P2.25, Rows = P2.0,P2.1)
 * ============================================================ */
#define KBD_COL1 (1u<<25)
#define KBD_ROW1 (1u<<0)
#define KBD_ROW2 (1u<<1)

static void Keypad_Init(void){
    PINSEL4 &= ~((3<<(0*2))|(3<<(1*2))); // P2.0,P2.1 -> GPIO
    PINSEL5 &= ~(3<<((25-16)*2));        // P2.25 -> GPIO
    FIO2DIR &= ~(KBD_ROW1|KBD_ROW2);
    FIO2DIR |=  KBD_COL1;
    FIO2SET  =  KBD_COL1;
}

static uint8_t read_rows(void){
    FIO2CLR = KBD_COL1;
    delay_loops(300);
    uint32_t r = FIO2PIN;
    FIO2SET = KBD_COL1;
    return (r & 3);
}

int SW2_Pressed(void){
    uint8_t s = ((read_rows() & 1u) == 0u);
    if (s){ delay_loops(100000); return 1; }
    return 0;
}

int SW6_Pressed(void){
    uint8_t s = ((read_rows() & 2u) == 0u);
    if (s){ delay_loops(100000); return 1; }
    return 0;
}

/* ============================================================
 *   EMC + Flash Initialization
 * ============================================================ */
void flash_hw_init(void)
{
    PCONP |= (1u<<11);   /* Power up EMC */

    /* Data bus D0..D15 = P3.0..P3.15 (PINSEL6 func 01) */
    for (int b=0; b<32; b+=2)
        PINSEL6 = (PINSEL6 & ~(3u<<b)) | (1u<<b);

    /* Address A0..A14 = P4.1..P4.15 (PINSEL8 func 01) */
    for (int p=1; p<=15; ++p)
        PINSEL8 = (PINSEL8 & ~(3u<<(p*2))) | (1u<<(p*2));

    /* Control & higher address lines */
    PINSEL9 = 0x05555555;  /* A15..A22, OE, WE, CS0 */

    EMCControl = 1;
    EMCConfig = 0;
    EMCStaticConfig0 = 0x81;     /* x16 mode, buffer enabled */
    EMCStaticWaitWen0 = 2;
    EMCStaticWaitOen0 = 3;
    EMCStaticWaitRd0  = 7;
    EMCStaticWaitWr0  = 7;
    EMCStaticWaitTurn0 = 3;

    Keypad_Init();
}

/* ============================================================
 *   NOR Flash Low-level Routines
 * ============================================================ */
static void flash_reset(void){ F16(0) = 0xF0; delay_loops(100); }

static int flash_wait(uint32_t w){
    uint16_t a,b;
    do { a=F16(w); b=F16(w); } while((a^b)&0x40);
    return 0;
}

void flash_erase(void)
{
    flash_reset();
    F16(UNLOCK1)=0xAA; F16(UNLOCK2)=0x55; F16(UNLOCK1)=0x80;
    F16(UNLOCK1)=0xAA; F16(UNLOCK2)=0x55; F16(0)=0x30;
    flash_wait(0);
}

static void flash_program(uint32_t addr,uint16_t data)
{
    uint32_t w=(addr&~1)>>1;
    F16(UNLOCK1)=0xAA; F16(UNLOCK2)=0x55; F16(UNLOCK1)=0xA0;
    F16(w)=data;
    flash_wait(w);
}

void flash_write_demo(void)
{
    uint16_t pattern[64];
    for(int i=0;i<64;i++) pattern[i]=i+1;
    for(int i=0;i<64;i++) flash_program(i*2,pattern[i]);
}

/* ============================================================
 *   UART Dump of Flash Content
 * ============================================================ */
static void uart_putc(char c){ while(!(U0LSR&(1<<5))); U0THR=c; }
static void uart_puts(const char*s){ while(*s){ if(*s=='\n')uart_putc('\r'); uart_putc(*s++);} }
static void uart_hex(uint32_t v,int n){
    static const char h[]="0123456789ABCDEF";
    for(int i=n-1;i>=0;i--) uart_putc(h[(v>>(i*4))&0xF]);
}

void flash_uart_dump(void)
{
    uart_puts("\r\nFLASH DATA:\r\n");
    volatile const uint16_t* p=(volatile const uint16_t*)NOR_BASE;
    for(int i=0;i<64;i++){
        uart_puts("0x"); uart_hex(NOR_BASE+i*2,8);
        uart_puts(" = 0x"); uart_hex(p[i],4);
        uart_puts("\r\n");
    }
}
