#include "LPC24xx.h"
#include "flashread.h"
#include "glcd.h"

/* ==== Small helpers ==== */
static inline void delay_loops(volatile uint32_t n){ while(n--) __asm volatile("nop"); }

/* Your GLCD row writer */
static inline void row_wr(uint8_t page, const char* s){
    GLCD_RowWriteMargin(page, s);
}

/* ==== EMC register window (if your vendor header doesn't provide them) ==== */
#ifndef EMC_BASE_ADDR
#define EMC_BASE_ADDR          (0xFFE08000UL)
#endif
#define EMCControl             (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x000))
#define EMCConfig              (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x008))

/* Static Memory Bank 0 (CS0) */
#define EMCStaticConfig0       (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x200))
#define EMCStaticWaitWen0      (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x204))
#define EMCStaticWaitOen0      (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x208))
#define EMCStaticWaitRd0       (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x20C))
#define EMCStaticWaitPage0     (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x210))
#define EMCStaticWaitWr0       (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x214))
#define EMCStaticWaitTurn0     (*(volatile unsigned long *)(EMC_BASE_ADDR + 0x218))

/* 16-bit access view (word offsets) */
#define F16(off) (*((volatile uint16_t *)(NOR_BASE_ADDR) + (off)))

void FlashRead_EmcInit(void)
{
    /* Power EMC */
    PCONP |= (1u << 11);                /* PCEMC */

    for (int b = 0; b < 32; b += 2)
        PINSEL6 = (PINSEL6 & ~(3u << b)) | (1u << b);

    for (int p = 1; p <= 15; ++p)
        PINSEL8 = (PINSEL8 & ~(3u << (p * 2))) | (1u << (p * 2));

    for (int p = 16; p <= 22; ++p)
        PINSEL9 = (PINSEL9 & ~(3u << ((p - 16) * 2))) | (1u << ((p - 16) * 2));
    PINSEL9 = (PINSEL9 & ~(3u << ((24 - 16) * 2))) | (1u << ((24 - 16) * 2)); /* OE  */
    PINSEL9 = (PINSEL9 & ~(3u << ((25 - 16) * 2))) | (1u << ((25 - 16) * 2)); /* WE  */
    PINSEL9 = (PINSEL9 & ~(3u << ((30 - 16) * 2))) | (1u << ((30 - 16) * 2)); /* CS0 */

    EMCControl = 1;
    EMCConfig  = 0;

    EMCStaticConfig0   = 0x00000001u        /* MW=01 (x16) */
                       | (1u << 7);         /* buffer/page enable */
    EMCStaticWaitWen0  = 2;                 /* WE# -> CS# delay    */
    EMCStaticWaitOen0  = 3;                 /* OE# access delay    */
    EMCStaticWaitRd0   = 7;                 /* read wait states    */
    EMCStaticWaitPage0 = 0;                 /* no page mode        */
    EMCStaticWaitWr0   = 7;                 /* write wait states   */
    EMCStaticWaitTurn0 = 3;                 /* turnaround cycles   */

    delay_loops(5000);
}

void FlashRead_Reset(void)
{
    F16(0) = 0x00F0u;
    delay_loops(100);
}

void FlashRead_ShowASCII(uint32_t byte_addr, uint32_t nbytes, uint8_t row0)
{
    const volatile uint8_t* base = (const volatile uint8_t*)(NOR_BASE_ADDR + byte_addr);

    const uint32_t per_line = 20;
    char line[21];
    line[20] = '\0';

    uint8_t row = row0;
    uint32_t remaining = nbytes;

    for (int ln = 0; ln < 4 && remaining; ++ln) {
        uint32_t take = (remaining > per_line) ? per_line : remaining;

        for (uint32_t i = 0; i < take; ++i) {
            uint8_t c = base[ln * per_line + i];
            line[i] = (c >= 32u && c <= 126u) ? (char)c : '.';
        }
        for (uint32_t i = take; i < per_line; ++i) line[i] = ' ';

        row_wr(row, line);

        remaining -= take;
        row += 2;                  /* next visible text row on your GLCD */
    }
}

void FlashRead_ShowFirst80_ASCII(uint32_t byte_addr)
{
    /* Show banner rows (optional – change to taste) */
    row_wr(0, "WELCOME TO AKADEMIKA");
    row_wr(2, "      PL-ARM7       ");
    row_wr(4, "FLASH READ EXPT     ");

    /* First 80 bytes shown on rows 0x06, 0x08, 0x0A, 0x0C if you use those,
       but your typical pattern is 0,2,4,6 – so we’ll use 6 for the block. */
    FlashRead_ShowASCII(byte_addr, 80u, 6);
}
