#include "LPC24xx.h"
#include <stdint.h>
#include "uart0.h"
#include "flashread.h"

int main(void)
{
    /* If PCLK_UART0 is 12 MHz, pass 12000000. Adjust per your clocks. */
    UART0_Init_9600(12000000u);

    FlashRead_EmcInit();
    FlashRead_Reset();

    UART0_SendString("\r\nPress any key to dump first 64 words...\r\n");
    /* Optional: wait for a received character (polling) */
    while ((U0LSR & (1u<<0)) == 0) { /* wait */ }
    (void)U0RBR; /* clear it */

    FlashRead_DumpWords(0x00000000u, 64);

    while (1) { /* idle */ }
}

