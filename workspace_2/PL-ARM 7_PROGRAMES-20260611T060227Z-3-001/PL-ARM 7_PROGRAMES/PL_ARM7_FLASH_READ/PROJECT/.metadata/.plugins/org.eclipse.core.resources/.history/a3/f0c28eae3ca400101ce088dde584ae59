static inline void delay_ms(uint32_t ms)
{
    volatile uint32_t n = ms * 8000u;
    while (n--) __asm volatile("nop");
}
void UART0_Init(void) {
    PCONP |= (1 << 3); // Power up UART0
    PCLKSEL0 &= ~(3 << 6); // PCLK for UART0 = CCLK / 4

    PINSEL0 &= ~((3 << 4) | (3 << 6));
    PINSEL0 |=  (1 << 4) | (1 << 6);

    U0LCR = 0x83; // 8 bits, no parity, 1 stop bit, DLAB = 1

    U0DLM = 0;
    U0DLL = 4;
    U0FDR = (8 << 4) | 5; // MULVAL = 8, DIVADDVAL = 5

    U0LCR = 0x03; // DLAB = 0
    U0FCR = 0x07; // Enable FIFO, reset RX/TX FIFO
}

/* Converts a byte to two ASCII hex characters */
void byte_to_hex(uint8_t byte, char *hex)
{
    const char HEX[] = "0123456789ABCDEF";
    hex[0] = HEX[(byte >> 4) & 0x0F];
    hex[1] = HEX[byte & 0x0F];
}
static void UART0_PutC(char c){ while(!(U0LSR&(1<<5))); U0THR=c; }
static void UART0_PutS(const char *s){ while(*s){ if(*s=='\n')UART0_PutC('\r'); UART0_PutC(*s++);} }



 


