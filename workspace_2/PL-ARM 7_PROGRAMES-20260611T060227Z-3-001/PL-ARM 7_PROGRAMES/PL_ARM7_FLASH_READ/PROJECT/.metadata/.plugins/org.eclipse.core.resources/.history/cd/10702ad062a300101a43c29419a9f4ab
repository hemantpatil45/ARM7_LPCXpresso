#include "LPC24xx.h"
#include "uart0.h"

/* Polled: wait for THR empty */
static inline void _uart0_wait_thr_empty(void){
    while ((U0LSR & (1u << 5)) == 0) { /* spin */ }
}

void UART0_Init_9600(uint32_t pclk_hz)
{
    /* Power UART0 */
    PCONP |= (1u << 3);                 /* PCUART0 = 1 */

    /* Pin mux: P0.2=TXD0, P0.3=RXD0 (function 01) */
    PINSEL0 = (PINSEL0 & ~((3u<<4) | (3u<<6))) | ((1u<<4) | (1u<<6));

    /* FIFOs on, reset RX/TX FIFOs */
    U0FCR = (1u<<0) | (1u<<1) | (1u<<2);

    /* 8N1, DLAB=1 */
    U0LCR = 0x83;

    /* Divisor = PCLK / (16*baud). Keep fractional divider disabled (MUL=1,DIVADD=0). */
    const uint32_t baud = 9600u;
    uint32_t div = (pclk_hz + (8u*baud)) / (16u*baud);   /* rounded */
    if (div == 0) div = 1;

    U0DLL = (uint8_t)(div & 0xFF);
    U0DLM = (uint8_t)((div >> 8) & 0xFF);
    U0FDR = (1u << 4);  /* MULVAL=1, DIVADDVAL=0 */

    /* DLAB=0, 8N1 */
    U0LCR = 0x03;
}

void UART0_SendChar(char c)
{
    _uart0_wait_thr_empty();
    U0THR = (uint8_t)c;
}

void UART0_SendString(const char *s)
{
    while (*s) {
        if (*s == '\n') UART0_SendChar('\r');
        UART0_SendChar(*s++);
    }
}
