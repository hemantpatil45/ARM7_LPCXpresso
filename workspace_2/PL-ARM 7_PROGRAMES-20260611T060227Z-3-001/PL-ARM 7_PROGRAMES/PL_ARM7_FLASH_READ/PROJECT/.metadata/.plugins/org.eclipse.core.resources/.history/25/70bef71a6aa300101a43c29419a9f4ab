/*
 * main.c — Read back data from SST39VF3202C (CS0, x16) and show on GLCD
 * Requires: LPC24xx.h, system_init.h, glcd.h, flashwrite.h (for EMC init + reset)
 */

#include <stdint.h>
#include "LPC24xx.h"
#include "system_init.h"
#include "glcd.h"
#include "flashread.h"

/* NOR base on EMC CS0 */
#define NOR_BASE_ADDR   (0x80000000UL)

/* tiny delay (only for brief UI pacing) */
static inline void fw_delay_loops(volatile uint32_t n){ while(n--) __asm volatile("nop"); }
static void fw_delay_ms(uint32_t ms){ while(ms--) fw_delay_loops(72000); }  /* ~1ms @ ~72MHz */

static void show_banner(void)
{
    GLCD_RowWriteMargin(0, "WELCOME TO AKADEMIKA");
    GLCD_RowWriteMargin(2, "      PL-ARM7       ");
    GLCD_RowWriteMargin(4, "FLASH READ EXPT     ");
    GLCD_RowWriteMargin(6, "Reading NOR...      ");
}

/* Copy a chunk from NOR and make it printable for the GLCD */
static void read_printable_line_from_nor(uint32_t byte_off, char *dst, unsigned max_chars)
{
    const volatile uint8_t *p = (const volatile uint8_t *)(NOR_BASE_ADDR + byte_off);
    for (unsigned i = 0; i < max_chars; i++) {
        uint8_t c = p[i];
        /* Make non-printables visible on the display */
        if (c < 0x20 || c > 0x7E) c = '.';
        dst[i] = (char)c;
    }
    dst[max_chars] = 0;
}

int main(void)
{
    /* Clocks / board mux */
    PLL_Init();
    system_Init();        /* your existing pins & clocks setup */  :contentReference[oaicite:0]{index=0}

    /* GLCD */
    GLCD_Init();
    GLCD_Clear();
    show_banner();

    /* EMC + NOR */
    FlashWrite_EmcInit();  /* configure CS0 x16 timing & pinmux */
    FlashWrite_Reset();    /* reset to read array mode */

    /* Small pause so the user sees the banner */
    fw_delay_ms(10);

    /* ---- Read back from NOR and show on GLCD ----
       We read 4 lines x 20 chars each:
         Row 5: bytes 0x0000..0x0013
         Row 6: bytes 0x0014..0x0027
         Row 7: bytes 0x0028..0x003B
         Row 3: bytes 0x003C..0x004F  (just to show more data)
    */
    char line[21];

    read_printable_line_from_nor(0x0000, line, 20);
    GLCD_RowWriteMargin(5, line);

    read_printable_line_from_nor(0x0014, line, 20);
    GLCD_RowWriteMargin(6, line);

    read_printable_line_from_nor(0x0028, line, 20);
    GLCD_RowWriteMargin(7, line);

    read_printable_line_from_nor(0x003C, line, 20);
    GLCD_RowWriteMargin(3, line);

    /* Done */
    GLCD_RowWriteMargin(6, "READ DONE            ");

    while (1) {
        /* idle here */
    }
}
