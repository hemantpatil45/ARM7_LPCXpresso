#include "LPC24xx.h"
#include "uart.h"

#define PCLK 12000000UL  // Peripheral clock = 12 MHz

void UART0_SendChar(char c) {
    while (!(U0LSR & (1 << 6))); // Wait until THR is empty
    U0THR = c;
}

void UART0_SendString(const char *str) {
    while (*str) {
        UART0_SendChar(*str++);
    }
}

void UART0_Init(void) {
    PCONP |= (1 << 3);           // Power up UART0
    PCLKSEL0 &= ~(3 << 6);       // PCLK = CCLK / 4

    // P0.2 = TXD0, P0.3 = RXD0
    PINSEL0 &= ~((3 << 4) | (3 << 6));
    PINSEL0 |=  (1 << 4) | (1 << 6);

    U0LCR = 0x83; // 8N1, DLAB = 1
    U0DLM = 0;
    U0DLL = 4;
    U0FDR = (8 << 4) | 5; // MULVAL = 8, DIVADDVAL = 5

    U0LCR = 0x03; // DLAB = 0
    U0FCR = 0x07; // Enable FIFO, reset RX/TX FIFO
}
