#include <stdint.h>
#include "LPC24xx.h"
#include "system_init.h"
#include "glcd.h"
#include "switch_led.h"

static inline void delay_cycles(uint32_t cycles){ while(cycles--) __asm__("nop"); }
static inline void update_row_on_change(uint8_t row, uint8_t bit, unsigned sw, unsigned prev);
/* helper: update GLCD row only when switch bit changes */

int main(void) {
    PLL_Init();        // setup PLL & clock
    system_Init();     // setup GPIOs, etc.
    GLCD_Init();
    GLCD_Clear();

    // Banner
    GLCD_RowWriteMargin(0, "     WELCOME TO     ");
    GLCD_RowWriteMargin(2, "     AKADEMIKA      ");
    GLCD_RowWriteMargin(4, "PL-ARM7 DEVELOPMENT ");
    GLCD_RowWriteMargin(6, "       BOARD        ");
    delay_cycles(10000);

    unsigned prev_sw = 0xFFFFFFFF;   // force first update

    while (1) {
        unsigned int sw_state = Read_Switches();

        // LEDs follow switches
        if (sw_state & (1u << 0)) { LED0_ON; } else { LED0_OFF; }
        if (sw_state & (1u << 1)) { LED1_ON; } else { LED1_OFF; }
        if (sw_state & (1u << 2)) { LED2_ON; } else { LED2_OFF; }
        if (sw_state & (1u << 3)) { LED3_ON; } else { LED3_OFF; }

        // Update GLCD only on changes
        update_row_on_change(4, 0, sw_state, prev_sw);
        update_row_on_change(5, 1, sw_state, prev_sw);
        update_row_on_change(6, 2, sw_state, prev_sw);
        update_row_on_change(7, 3, sw_state, prev_sw);

        prev_sw = sw_state;
    }

    // never reached
    // return 0;
}
