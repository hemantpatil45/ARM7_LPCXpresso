/*
 * ext_interrupt.h
 * EINT0 (P2.10) → toggle LED2 (P2.21, active-LOW)
 */

#ifndef EXT_INTERRUPT_H_
#define EXT_INTERRUPT_H_

#ifdef __cplusplus
extern "C" {
#endif

/* Init EINT0 on P2.10 (falling edge), set LED2 as output (OFF initially) */
void EINT0_Init(void);

/* ISR prototype (exported for the VIC vector) */
void EINT0_IRQHandler(void) __attribute__((interrupt("IRQ")));

#ifdef __cplusplus
}
#endif

#endif /* EXT_INTERRUPT_H_ */
