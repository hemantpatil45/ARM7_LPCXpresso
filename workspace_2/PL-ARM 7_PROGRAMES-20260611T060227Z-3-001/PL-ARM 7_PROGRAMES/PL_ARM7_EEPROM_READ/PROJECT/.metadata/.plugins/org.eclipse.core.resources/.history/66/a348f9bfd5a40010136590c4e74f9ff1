#ifndef I2CREAD_H_
#define I2CREAD_H_

#include <stdint.h>

/* I2C0 @ 100 kHz on P0.27 (SDA0) / P0.28 (SCL0) */
void I2C0_Init_100k(void);

/* AT24C512 (7-bit = 0x50) random read: read 'len' bytes starting at 'addr' */
void AT24C512_Read(uint16_t addr, uint8_t *dst, uint16_t len);

/* Keypad SW2 support (Row1=P2.0, Col1=P2.25):
   - init configures the GPIO directions
   - SW2_Pressed() returns 1 when pressed (active-LOW), else 0 */
void SW2_Keypad_Init(void);
uint32_t SW2_Pressed(void);

#endif /* I2CREAD_H_ */

