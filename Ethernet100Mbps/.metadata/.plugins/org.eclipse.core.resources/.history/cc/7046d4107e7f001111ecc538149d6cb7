/* ==============================================================================
 * MAIN ETHERNET INITIALIZATION (FORCED 10 Mbps)
 * ============================================================================== */
bool Eth_Init(void)
{
    uint32_t timeout;
    uint16_t phyStatus;

    Eth_InitPins();

    /* Reset MAC */
    LPC_EMAC->MAC1 = MAC1_RES_TX | MAC1_RES_MCS_TX | MAC1_RES_RX | MAC1_RES_MCS_RX | MAC1_SIM_RES | MAC1_SOFT_RES;
    LPC_EMAC->COMMAND = CR_REG_RES | CR_TX_RES | CR_RX_RES;
    for (timeout = 100; timeout; timeout--);

    /* MAC RMII Config */
    LPC_EMAC->MAC1 = MAC1_PASS_ALL | MAC1_REC_EN;
    LPC_EMAC->COMMAND = CR_RMII;
    LPC_EMAC->MCFG = 0x0018;
    LPC_EMAC->MAC2 = MAC2_CRC_EN | MAC2_PAD_EN;
    LPC_EMAC->MAXF = 1536;
    LPC_EMAC->CLRT = 0x370F;
    LPC_EMAC->IPGR = 0x0C12;
    LPC_EMAC->IPGT = 0x0015;

    /* PHY Soft Reset */
    Eth_WritePHY(DP83848_BMCR, PHY_BMCR_RESET);
    for (timeout = 0; timeout < 0xFFFFF; timeout++) {
        if ((Eth_ReadPHY(DP83848_BMCR) & PHY_BMCR_RESET) == 0) break;
    }

    /* -----------------------------------------------------------------
       FORCE 10 Mbps CONFIGURATION
       ----------------------------------------------------------------- */

    /* 1. Force the PHY to 10 Mbps, Full Duplex, No Auto-Negotiation */
    /* 0x0100 -> Bit 13=0 (10 Mbps), Bit 12=0 (Auto-Neg Off), Bit 8=1 (Full Duplex) */
    Eth_WritePHY(DP83848_BMCR, 0x0100);

    /* Small delay for PHY state to settle */
    for (timeout = 0; timeout < 100000; timeout++);

    /* 2. Configure MAC SUPP Register for 10 Mbps */
    /* Clear bit 8 to set MAC internal timing to 10 Mbps */
    LPC_EMAC->SUPP &= ~(1 << 8);

    /* ----------------------------------------------------------------- */

    /* Duplex Config based on PHY Status */
    phyStatus = Eth_ReadPHY(DP83848_PHYSTS);
    if (phyStatus & PHY_STS_DUPLEX) {
        LPC_EMAC->MAC2 |= MAC2_FULL_DUP;
        LPC_EMAC->COMMAND |= CR_FULL_DUP;
        LPC_EMAC->IPGT = 0x0015;
    } else {
        LPC_EMAC->IPGT = 0x0012;
    }

    /* Set MAC Address */
    LPC_EMAC->SA0 = 0x1100;
    LPC_EMAC->SA1 = 0x3322;
    LPC_EMAC->SA2 = 0x5544;

    /* Init DMA Memory */
    EMAC_RxInit();

    /* Enable TX/RX */
    LPC_EMAC->RXFILTERCTRL = RXFILT_CTRL_BROADCAST | RXFILT_CTRL_PERFECT;
    LPC_EMAC->INTENABLE = 0;
    LPC_EMAC->INTCLEAR = 0xFFFF;
    LPC_EMAC->COMMAND |= (CR_RX_EN | CR_TX_EN);
    LPC_EMAC->MAC1 |= MAC1_REC_EN;

    return true;
}


