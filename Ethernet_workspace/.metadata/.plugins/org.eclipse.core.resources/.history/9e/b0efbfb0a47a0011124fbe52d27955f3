#include "LPC24xx.h"
#include "ethernet_rx.h"
#include "ethernet_reg.h"

/*
 * Define the memory locations for the RX Descriptor Ring.
 * These constants map to the local AHB SRAM on the LPC2478 (starts at 0x7FE00000)
 */
#define NUM_RX_FRAG         4    /* Number of RX blocks in the ring */
#define ETH_RX_FRAG_SIZE    1536 /* Max Ethernet Packet Size */

/* DMA Memory pointers calculation */
#define RX_DESC_BASE        0x7FE00000
#define RX_STAT_BASE        (RX_DESC_BASE + (NUM_RX_FRAG * 8))
#define RX_BUF_BASE         (RX_STAT_BASE + (NUM_RX_FRAG * 8))

/* Descriptor Structure pointers */
static uint32_t *RX_DESC_PACKET_PTRS;
static uint32_t *RX_DESC_CTRL_PTRS;
static uint32_t *RX_STAT_INFO_PTRS;

void EMAC_RxInit(void)
{
    uint32_t i;

    RX_DESC_PACKET_PTRS = (uint32_t *)RX_DESC_BASE;
    RX_DESC_CTRL_PTRS   = (uint32_t *)(RX_DESC_BASE + 4);
    RX_STAT_INFO_PTRS   = (uint32_t *)RX_STAT_BASE;

    /* Initialize the ring buffer memory blocks */
    for (i = 0; i < NUM_RX_FRAG; i++) {
        /* Set buffer address */
        RX_DESC_PACKET_PTRS[i * 2] = RX_BUF_BASE + (i * ETH_RX_FRAG_SIZE);

        /* Set control info: Size of buffer and enable Interrupt generation */
        RX_DESC_CTRL_PTRS[i * 2]   = (ETH_RX_FRAG_SIZE - 1) | (1UL << 31);

        /* Clear Status Info */
        RX_STAT_INFO_PTRS[i * 2] = 0;
        RX_STAT_INFO_PTRS[(i * 2) + 1] = 0;
    }

    /* Pass the base addresses to the MAC hardware registers */
    LPC_EMAC->RXDESCRIPTOR    = RX_DESC_BASE;
    LPC_EMAC->RXSTATUS        = RX_STAT_BASE;
    LPC_EMAC->RXDESCRIPTORNUM = NUM_RX_FRAG - 1;

    /* Reset the Consume index to 0 */
    LPC_EMAC->RXCONSUMEINDEX  = 0;
}

bool EMAC_ReceivePacket(uint8_t *rx_buffer, uint32_t *rx_length)
{
    uint32_t consume_idx;
    uint32_t produce_idx;
    uint32_t packet_size;
    uint8_t *dma_buffer_ptr;
    uint32_t info_word;
    uint32_t i;

    consume_idx = LPC_EMAC->RXCONSUMEINDEX;
    produce_idx = LPC_EMAC->RXPRODUCEINDEX;

    /* 1. Check if the Ring Buffer is empty (no new packets) */
    if (consume_idx == produce_idx) {
        return false;
    }

    /* 2. Get packet info and calculate size (masking the lower 11 bits) */
    info_word = RX_STAT_INFO_PTRS[consume_idx * 2];
    packet_size = (info_word & 0x7FF);

    /* Subtract the 4-byte Ethernet CRC that hardware automatically appends */
    if (packet_size > 4) {
        packet_size -= 4;
    }

    *rx_length = packet_size;

    /* 3. Copy data from the DMA AHB SRAM to your local application array */
    dma_buffer_ptr = (uint8_t *)RX_DESC_PACKET_PTRS[consume_idx * 2];
    for (i = 0; i < packet_size; i++) {
        rx_buffer[i] = dma_buffer_ptr[i];
    }

    /* 4. Advance the Consume Index to give the block back to the hardware */
    if (++consume_idx == (LPC_EMAC->RXDESCRIPTORNUM + 1)) {
        consume_idx = 0;
    }
    LPC_EMAC->RXCONSUMEINDEX = consume_idx;

    return true;
}
