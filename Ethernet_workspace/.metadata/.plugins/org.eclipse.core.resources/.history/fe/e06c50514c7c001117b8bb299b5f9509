#include "LPC24xx.h"
#include "glcd.h"
#include "system_init.h" // Assuming this contains your PLL and system setup
#include <stdint.h>
#include <stdio.h>

// --- UART Functions ---
void UART0_Init(void) {
    PCONP |= (1 << 3);           // Enable UART0 power
    PCLKSEL0 &= ~(3 << 6);       // PCLK = CCLK/4 = 18MHz (for 72MHz CPU)

    PINSEL0 &= ~((3 << 4) | (3 << 6));
    PINSEL0 |= (1 << 4) | (1 << 6);

    U0LCR = 0x83; U0DLM = 0; U0DLL = 117; // 117 divisor for 9600 baud @ 18MHz
    U0LCR = 0x03; U0FCR = 0x07;
}

void UART0_SendString(const char *s) {
    while(*s) {
        while(!(U0LSR & (1 << 5)));
        U0THR = *s++;
    }
}

// Helper to show values on GLCD
void GLCD_Debug(int line, const char *label, int value) {
    char buffer[21];
    sprintf(buffer, "%s: %d      ", label, value);
    GLCD_RowWriteMargin(line, buffer);
}

int main(void) {
    // 1. MUST initialize system clock/PLL first
    PLL_Init();
    system_Init();

    // 2. Initialize Peripherals
    GLCD_Init();
    GLCD_Clear();
    UART0_Init();

    GLCD_RowWriteMargin(0, "UART & PLL TEST");
    UART0_SendString("System Booted at 72MHz\r\n");

    int counter = 0;

    while(1) {
        counter++;
        UART0_SendString("Sending Debug Data...\r\n");

        // 3. Update GLCD Debuggers
        GLCD_Debug(2, "Counter", counter);
        GLCD_Debug(4, "CPU MHz", 72);        // Confirming intended speed
        GLCD_Debug(6, "Baud Div", 117);      // Confirming UART math

        // 4. Delay
        volatile uint32_t i;
        for(i = 0; i < 5000000; i++);
    }
}
