#include <stdint.h>
#include <stdbool.h>
#include <string.h> // Required for memcpy
#include "LPC24xx.h"
#include "glcd.h"
#include "system_init.h"
#include "ethernet.h"
#include "ethernet_rx.h"

#define MAX_GLCD_CHARS 20

void Delay1Sec(void) {
    volatile uint32_t i;
    for(i = 0; i < 12000000; i++) { __asm("NOP"); }
}

int main(void) {
    bool link_status;
    uint8_t rx_buffer[64];      // Hardware DMA buffer
    uint8_t local_buffer[64];  // Local copy to prevent race conditions
    uint32_t rx_length = 0;
    uint32_t j;
    volatile uint32_t i;

    /* UART/Debugger safety delay */
    for(i = 0; i < 50000; i++) { __asm("NOP"); }

    PLL_Init();
    system_Init();

    GLCD_Init();
    GLCD_Clear();
    GLCD_RowWriteMargin(0, "RX BOARD: BOOTING...");

    link_status = Eth_Init();

    if (link_status) {
        GLCD_RowWriteMargin(2, "Link Status: UP   ");
    } else {
        GLCD_RowWriteMargin(2, "Link Status: FAIL ");
    }

    while(1) {
        if (link_status) {
            /* Poll DMA memory for new packets */
            if (EMAC_ReceivePacket(rx_buffer, &rx_length)) {

                /*
                 * CRITICAL FIX: Immediately copy the hardware buffer to a local buffer.
                 * This releases the hardware buffer so the Ethernet controller can
                 * receive the next packet immediately, while we process the current one.
                 */
                memcpy(local_buffer, rx_buffer, (rx_length > 64) ? 64 : rx_length);

                char display_str[MAX_GLCD_CHARS + 1];

                /* Extract payload starting at index 14, capped at 20 characters */

                if (local_buffer[14] == 0x48) {

                    GLCD_RowWriteMargin(4, "Packet Received!  ");

                    for(j = 0; j < MAX_GLCD_CHARS; j++) {
                        // Safely extract from local_buffer
                        if ((14 + j) < rx_length && (local_buffer[14 + j] >= 32 && local_buffer[14 + j] <= 126)) {
                            display_str[j] = (char)local_buffer[14 + j];
                        } else {
                            display_str[j] = ' '; // Pad with space
                        }
                    }

                    display_str[MAX_GLCD_CHARS] = '\0'; // Null-terminate
                    GLCD_RowWriteMargin(4, display_str);

                    /* Visual hold before clearing rows */
                    for(i = 0; i < 2000000; i++) { __asm("NOP"); }

                    /* Clear line */
                    GLCD_RowWriteMargin(4, "                    ");
                }
            }
        }
    }
}
