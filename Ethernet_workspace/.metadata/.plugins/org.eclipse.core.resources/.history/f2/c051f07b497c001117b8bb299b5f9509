#include "LPC24xx.h"

// Simple delay function
void delay(int count) {
    while(count--);
}

void UART0_Init(void) {
    // 1. Enable power to UART0
    PCONP |= (1 << 3);

    // 2. Configure pins P0.2 (TXD0) and P0.3 (RXD0)
    // PINSEL0 bits 4:7 set to 01 for TXD0/RXD0
    PINSEL0 &= ~(0xF << 4);
    PINSEL0 |=  (0x5 << 4);

    // 3. Set baud rate to 9600 (Assuming 12MHz PCLK for this example)
    // Formula: Baud = PCLK / (16 * (256 * DLM + DLL))
    U0LCR = 0x83; // DLAB=1, 8 bits, no parity, 1 stop bit
    U0DLM = 0x00;
    U0DLL = 0x4E; // Value for 9600 baud at 12MHz PCLK
    U0LCR = 0x03; // DLAB=0
}

void UART0_SendChar(char c) {
    // Wait until Transmit Holding Register is empty
    while (!(U0LSR & 0x20));
    U0THR = c;
}

int main(void) {
    UART0_Init();

    while(1) {
        UART0_SendChar('A'); // Send 'A' repeatedly
        delay(1000000);      // Small delay
    }
}
