#include <stdint.h>
#include <stdbool.h>
#include "LPC24xx.h"
#include "glcd.h"
#include "system_init.h"
#include "ethernet.h"
#include "ethernet_tx.h"

void Delay1Sec(void)
{
    volatile uint32_t i;
    for(i = 0; i < 12000000; i++) {
        __asm("NOP");
    }
}

int main(void)
{
    bool link_status;
    uint32_t tx_counter = 0;
    volatile uint32_t i; /* Added for the UART safety delay */

    /* ========================================================== */
    /* 1. UART FLASHER SAFETY DELAY (~10ms at 4MHz)               */
    /* Gives Flash Magic time to cleanly release the bootloader   */
    /* before we spike the CPU clock to 72MHz.                    */
    /* ========================================================== */
    for(i = 0; i < 50000; i++) {
        __asm("NOP");
    }

    /* ========================================================== */
    /* Removed the [64] limit. The compiler will now perfectly    */
    /* size this to the full 75 bytes required for your message.  */
    /* ========================================================== */
    uint8_t broadcast_frame[] = {
        0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
        0x00, 0x11, 0x22, 0x33, 0x44, 0x55,
        0x88, 0xB5,
        'W', 'e', 'l', 'c', 'o', 'm', 'e', ' ',
            't', 'o', ' ',
            'A', 'k', 'a', 'd', 'e', 'm', 'i', 'k', 'a', ' ',
            'P', 'L', '-', 'A', 'R', 'M', '7', ' ',
            'E', 't', 'h', 'e', 'r', 'n', 'e', 't', ' ',
            'd', 'e', 'm', 'o', ' ',
            'T', 'X', ' ',
            'd', 'a', 't', 'a', ' ',
            'r', 'e', 'c', 'e', 'i', 'v', 'e', 'd',
            '\r', '\n'
    };

    /* ========================================================== */
    /* 2. RAMP CLOCK TO 72MHz                                     */
    /* ========================================================== */
    PLL_Init();
    system_Init();

    /* ========================================================== */
    /* 3. PHY HARDWARE WAKE-UP DELAY (1 second at 72MHz)          */
    /* ========================================================== */
    Delay1Sec();

    GLCD_Init();
    GLCD_Clear();

    GLCD_RowWriteMargin(0,"WELCOME TO AKADEMIKA");
    GLCD_RowWriteMargin(2,"      PL-ARM7       ");
    GLCD_RowWriteMargin(4,"Ethernet Demo       ");

    /* Initializes MAC, PHY, and routing. Returns true if Link is negotiated. */
    link_status = Eth_Init();

    if (link_status) {
        GLCD_RowWriteMargin(6, "Link Status: UP   ");
    } else {
        GLCD_RowWriteMargin(6, "Link Status: FAIL ");
    }

    while(1) {
        if (link_status) {
            /* sizeof(broadcast_frame) now automatically safely calculates 75 */
            if (EMAC_SendPacket(broadcast_frame, sizeof(broadcast_frame))) {
                tx_counter++;
            } else {
                GLCD_RowWriteMargin(6, "TX Error: FULL    ");
            }
        }
        Delay1Sec();
    }
    return 0;
}
