#include "LPC24xx.h"
#include "ethernet_rx.h"

/* Direct Hardware Addresses for RX (Bypasses missing struct members) */
#define HW_RX_DESC_NUM    (*((volatile uint32_t *)0xFFE00110))
#define HW_RX_PRODUCE_IDX (*((volatile uint32_t *)0xFFE00114))
#define HW_RX_CONSUME_IDX (*((volatile uint32_t *)0xFFE00118))

extern uint32_t *RX_DESC_PACKET_PTRS;
extern uint32_t *RX_STAT_INFO_PTRS;

bool EMAC_ReceivePacket(uint8_t *rx_buffer, uint32_t *rx_length)
{
    uint32_t consume_idx;
    uint32_t produce_idx;
    uint32_t packet_size;
    uint32_t i;

    consume_idx = HW_RX_CONSUME_IDX;
    produce_idx = HW_RX_PRODUCE_IDX;

    /* If indices match, the ring buffer is empty */
    if (consume_idx == produce_idx) {
        return false;
    }

    /* Extract packet size (masking the lower 11 bits) */
    packet_size = (RX_STAT_INFO_PTRS[consume_idx] & 0x7FF);

    /* Subtract the 4-byte hardware CRC */
    if (packet_size > 4) {
        packet_size -= 4;
    }

    *rx_length = packet_size;

    /* Copy payload from DMA to local array */
    for (i = 0; i < packet_size; i++) {
        rx_buffer[i] = ((uint8_t *)RX_DESC_PACKET_PTRS[consume_idx])[i];
    }

    /* Advance Consume Index */
    if (++consume_idx == HW_RX_DESC_NUM) {
        consume_idx = 0;
    }
    HW_RX_CONSUME_IDX = consume_idx;

    return true;
}
