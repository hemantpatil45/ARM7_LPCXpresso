#include "LPC24xx.h"
#include "glcd.h"
#include "system_init.h" // Assuming this contains your PLL and system setup
#include <stdint.h>
#include <stdio.h>

// --- UART Functions ---
void UART0_Init(void) {
    PCONP |= (1 << 3);

    // Set PCLK to CCLK/1 (72 MHz)
    // Bits 6:7 set to 01 = CCLK/1
    PCLKSEL0 &= ~(3 << 6);
    PCLKSEL0 |=  (1 << 6);

    PINSEL0 &= ~((3 << 4) | (3 << 6));
    PINSEL0 |= (1 << 4) | (1 << 6);

    U0LCR = 0x83;        // DLAB=1

    // Divisor for 72MHz PCLK to get 9600 baud:
    // 72,000,000 / (16 * 9600) = 468.75
    // Integer part: 468 (0x01D4)
    U0DLM = 0x01;
    U0DLL = 0xD4;

    // Fractional Divider to handle the .75
    // Formula: (Mul / Div) = (1 - FractionalError)
    // Using standard table for 72MHz: Mul = 1, Div = 2
    U0FDR = (1 << 4) | 0;

    U0LCR = 0x03;        // DLAB=0
    U0FCR = 0x07;
}

void UART0_SendString(const char *s) {
    while(*s) {
        while(!(U0LSR & (1 << 5)));
        U0THR = *s++;
    }
}

// Helper to show values on GLCD
void GLCD_Debug(int line, const char *label, int value) {
    char buffer[21];
    sprintf(buffer, "%s: %d      ", label, value);
    GLCD_RowWriteMargin(line, buffer);
}

int main(void) {
    // 1. MUST initialize system clock/PLL first
    PLL_Init();
    system_Init();

    // 2. Initialize Peripherals
    GLCD_Init();
    GLCD_Clear();
    UART0_Init();

    GLCD_RowWriteMargin(0, "UART & PLL TEST");
    UART0_SendString("System Booted at 72MHz\r\n");

    int counter = 0;

    while(1) {
        counter++;
        UART0_SendString("Sending Debug Data...\r\n");

        // 3. Update GLCD Debuggers
        GLCD_Debug(2, "Counter", counter);
        GLCD_Debug(4, "CPU MHz", 72);        // Confirming intended speed
        GLCD_Debug(6, "Baud Div", 117);      // Confirming UART math

        // 4. Delay
        volatile uint32_t i;
        for(i = 0; i < 5000000; i++);
    }
}
