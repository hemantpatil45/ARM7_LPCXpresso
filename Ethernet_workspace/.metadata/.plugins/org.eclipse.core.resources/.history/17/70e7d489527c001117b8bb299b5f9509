#include "LPC24xx.h"
#include <stdint.h>
#include "ethernetrx.h"

/* ===== UART0 @ 9600 baud ===== */
#define PCLK 12000000UL

void UART0_SendChar(char c){
    while(!(U0LSR&(1<<5)));
    U0THR=c;
}
void UART0_SendString(const char *s){ while(*s) UART0_SendChar(*s++); }

void UART0_Init(void){
    PCONP|=(1<<3);
    PCLKSEL0&=~(3<<6);
    PINSEL0&=~((3<<4)|(3<<6));
    PINSEL0|=(1<<4)|(1<<6); // TXD0,RXD0
    U0LCR=0x83;
    U0DLM=0; U0DLL=4; U0FDR=(8<<4)|5; // 9600 baud
    U0LCR=0x03;
    U0FCR=0x07;
}

/* ===== LED (P2.15) ===== */
static void LED_Init(void){ SCS|=(1<<0); FIO2DIR|=(1<<15); FIO2CLR=(1<<15); }
static void LED_Toggle(void){ if(FIO2PIN&(1<<15)) FIO2CLR=(1<<15); else FIO2SET=(1<<15); }

static inline void delay_cycles(volatile uint32_t n){ while(n--) __asm__("nop"); }

/* ===== MAIN ===== */
int main(void){
    UART0_Init();
    LED_Init();
    UART0_SendString("\r\n=== LPC2478 Ethernet Receiver ===\r\n");

    ETH_Init();

    UART0_SendString("Waiting for Link...\r\n");
    while(!ETH_LinkUp());
    UART0_SendString("Link UP\r\n");

    char rxbuf[256];
    while(1){
        if(ETH_ReceiveText(rxbuf,sizeof(rxbuf))){
            UART0_SendString("RX: ");
            UART0_SendString(rxbuf);
            UART0_SendString("\r\n");
            LED_Toggle();
        }
        delay_cycles(200000);
    }
}
