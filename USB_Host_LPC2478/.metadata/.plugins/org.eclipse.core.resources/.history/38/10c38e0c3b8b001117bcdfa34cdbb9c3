#include "usb_host_lpc2478.h"
#include "usbhost_ms.h"
#include "uart0.h"

extern void delay_ms(uint32_t ms);

volatile DWORD g_USBConnected = 0;

void USBHost_HardwareInit(void) {
    // 1. Power up the USB Peripheral Block
    PCONP |= (1UL << 31);

    // 2. RESTORE YOUR ORIGINAL WORKING PINS (Func 01 hands control to OHCI)
    PINSEL0 = (PINSEL0 & ~(3UL << 24)) | (1UL << 24); // P0.12 -> USB_PPWR2
    PINSEL0 = (PINSEL0 & ~(3UL << 26)) | (1UL << 26); // P0.13 -> USB_UP_LED2
    PINSEL1 = (PINSEL1 & ~(3UL << 30)) | (1UL << 30); // P0.31 -> USB_D+2
    PINSEL3 = (PINSEL3 & ~(0xFUL << 28)) | (0x5UL << 28); // P1.30, P1.31
    PINMODE3 = (PINMODE3 & ~(0xFUL << 28)) | (0xAUL << 28);

    // 3. KEEP THE AHB CLOCK FIX
    OTG_CLK_CTRL = 0x1F;
    while ((OTG_CLK_STAT & 0x1F) != 0x1F);

    // 4. KEEP THE HOST ENABLE FIX
    OTG_STAT_CTRL = 0x03;
}

/* Restored Original Interrupt Handler */
void __attribute__((interrupt("IRQ"))) USB_IRQHandler(void) {
    DWORD int_stat = HC_INT_STAT;

    if (int_stat & (1UL << 6)) { // Root Hub Status Change
        if (HC_RH_PORT_STAT2 & 0x01) {
            g_USBConnected = 1;
        } else {
            g_USBConnected = 0;
        }
        HC_INT_STAT = (1UL << 6);
    }
    VICVectAddr = 0;
}

DWORD USBHost_OHCIInit(void) {
    HC_CONTROL = 0;
    HC_CMD_STAT = 0x01;
    while (HC_CMD_STAT & 0x01);

    if ((HC_REVISION & 0xFF) != 0x10) return USB_HOST_ERR;

    HC_INT_DIS = 0x8000007F;
    HC_HCCA = USB_OHCI_BASE_ADDR;
    HC_CTRL_HEAD_ED = 0;
    HC_BULK_HEAD_ED = 0;

    HC_FM_INTERVAL = (FM_INTERVAL_FSMPS << 16) | FM_INTERVAL_FI;
    HC_PERIOD_START = PERIODIC_START;
    HC_LS_THRHLD    = LS_THRESHOLD;

    HC_CONTROL = (0x02 << 6) | (1 << 5) | (1 << 4) | (1 << 3) | 0x03;
    for (volatile int i = 0; i < 10000; i++);

    // RESTORE ORIGINAL ROOT HUB DESCRIPTOR
    HC_RH_DESCA = (PWRON_TO_PWRGOOD << 24) | 0x0B01;
    HC_RH_DESCB = 0x0000;
    HC_RH_STAT = (1UL << 16);

    // ==========================================================
    // RESTORE THE MISSING INTERRUPTS I ACCIDENTALLY DELETED!
    // ==========================================================
    VICVectAddr22 = (unsigned long)USB_IRQHandler;
    VICVectPriority22 = 1;
    VICIntEnable = (1UL << 22);
    HC_INT_EN = 0x80000042; // Enable RootHubStatusChange interrupts

    return USB_HOST_OK;
}

/* The fixed reset port from earlier */
void USBHost_ResetPort(void) {
    HC_RH_PORT_STAT2 = (1UL << 4);
    volatile int timeout = 200000;
    while (!(HC_RH_PORT_STAT2 & (1UL << 20))) {
        if (--timeout == 0) break;
    }
    HC_RH_PORT_STAT2 = (1UL << 20);
    HC_RH_PORT_STAT2 = (1UL << 1);
    delay_ms(100);
}
