void UART0_SendChar(char c){
    while(!(U0LSR&(1<<5)));
    U0THR=c;
}
void UART0_SendString(const char *s){ while(*s) UART0_SendChar(*s++); }

void UART0_Init(void){
    PCONP|=(1<<3);
    PCLKSEL0&=~(3<<6);
    PINSEL0&=~((3<<4)|(3<<6));
    PINSEL0|=(1<<4)|(1<<6); // TXD0,RXD0
    U0LCR=0x83;
    U0DLM=0; U0DLL=4; U0FDR=(8<<4)|5; // 9600 baud
    U0LCR=0x03;
    U0FCR=0x07;
}

void Delay1Sec(void)
{
    volatile uint32_t i;
    for(i = 0; i < 120; i++) {
        __asm("NOP");
    }
}
void Delay2Sec(void)
{
    volatile uint32_t i;
    for(i = 0; i < 1200000; i++) {
        __asm("NOP");
    }
}

